#!/usr/bin/env bash
# card: the WorkDeck command-line tool.
# Version 0.1.3. https://github.com/AshwinSathian/workdeck
# SPDX-License-Identifier: MIT
#
# One file, so people and CI can fetch it without the plugin. It must run on
# bash 3.2 (macOS /bin/bash) with BSD or GNU awk, sed, grep and sort (with
# -V), git, and the usual POSIX tools (cut, tr, head, tail, mktemp, date).
# workdeck.conf and card files are parsed as text and are never sourced or
# evaluated.
#
# Reports go to stdout. Errors go to stderr and start with "card:".

# No -e: most commands collect several findings before they fail, and every
# pipeline's status is checked where it matters.
set -u
# Bytewise ranges and sort order everywhere. The trade-off: length limits
# count bytes, not characters, so a non-ASCII title gets fewer than 80.
LC_ALL=C
export LC_ALL

readonly VERSION=0.1.3
TAB=$(printf '\t')
readonly TAB

usage() {
  cat <<USAGE
card $VERSION: the WorkDeck command-line tool

usage: card <command> [arguments]

  next [--fetch]            print the first ready card
  show <id>                 print one card
  list [--fetch]            one line per card: state, id, size, title
  status [--fetch]          current card, open work, next ready card
  new <id> <title> [--size XS|S|M] [--depends ID,ID]
                            create a card file
  done <id>                 set done: true in the card file
  lint                      check every card and log file
  touched <id>              compare changed files with the card's Touch list
  tests <id>                check that each Tests line names a test that exists
  tokens [transcript]       baseline, peak and growth for a session transcript
  log-new <id> <outcome>    create a session log entry
  stats                     growth per card size across session logs
  plan                      check every outline in <cards_dir>/plan
  plan new <spec path> <PREFIX> [--level N]
                            create an outline with no rows
  plan accept <PREFIX>      set spec_blob to the specification's hash
  plan start <id>           create the card file for a row
  plan check <id>           check a card's paths against the working tree
  conf <key>                print one configuration value
  help, version

--fetch runs git fetch --prune and reads open pull requests with gh first.
card <command> --help prints that command's arguments.
Reports go to stdout; errors go to stderr and start with "card:".
Exit codes: 0 ok; 1 a check failed or nothing matched; 2 usage or
configuration error.
USAGE
}

# synopsis <command>: the arguments of one command.
synopsis() {
  case $1 in
    next | list | status) echo "card $1 [--fetch]" ;;
    lint | stats) echo "card $1" ;;
    plan) echo 'card plan [new <spec path> <PREFIX> [--level N] | accept <PREFIX> | start <id> | check <id>]' ;;
    show | done | touched | tests) echo "card $1 <id>" ;;
    new) echo 'card new <id> <title> [--size XS|S|M] [--depends ID,ID]' ;;
    tokens) echo 'card tokens [transcript]' ;;
    log-new) echo 'card log-new <id> <done|split|blocked|review-fixes>' ;;
    conf) echo 'card conf <key>' ;;
  esac
}

# usage_die <command> [reason]: a usage error for one command, exit 2.
usage_die() {
  [ -z "${2-}" ] || printf 'card: %s\n' "$2" >&2
  printf 'usage: %s\n' "$(synopsis "$1")" >&2
  exit 2
}

die() {
  local code=$1
  shift
  printf 'card: %s\n' "$*" >&2
  exit "$code"
}

# Every git call goes through here so user configuration cannot change the
# shape of the output.
g() { git -c core.quotepath=off -c color.ui=false -c grep.patternType=basic -c grep.column=false -c grep.lineNumber=false "$@"; }

enter_repo() {
  local root
  root=$(g rev-parse --show-toplevel 2>/dev/null) || die 2 "not a git repository"
  cd "$root" || die 2 "cannot enter $root"
  [ -f workdeck.conf ] ||
    die 2 "no workdeck.conf in $root; run /workdeck:init in Claude Code, or create one with a 'check = <command>' line"
}

# --- configuration ---

CONF_KEYS='version|check|base|cards_dir|log_dir|touch_ignore|status_max_chars|reviewer|budget[.][A-Z][A-Z0-9]*'
readonly CONF_KEYS
CONF=""

# dir_ok: a relative path inside the repository. Shared by load_conf and the
# outline reader.
DIR_OK_AWK='
function dir_ok(v) {
  return v ~ /^[A-Za-z0-9._][A-Za-z0-9._\/-]*$/ && v !~ /(^|\/)\.\.?(\/|$)/ && v !~ /\/\// && v !~ /\/$/
}'
readonly DIR_OK_AWK

# conf_get <key>: prints the value; fails when the key has none. Pure bash:
# it runs many times per command and a process costs milliseconds.
conf_get() {
  local line
  while IFS= read -r line; do
    case $line in
      "$1="*)
        printf '%s\n' "${line#"$1="}"
        return 0
        ;;
    esac
  done <<CONF
$CONF
CONF
  return 1
}

conf_die() { die 2 "workdeck.conf: $*"; }

# load_conf: one awk pass that applies defaults, parses and validates.
# Directory settings must stay inside the repository and the base branch must
# be a plain branch name, because both are handed to git and used to build
# file names. Nothing in the file is ever evaluated.
load_conf() {
  local parsed
  parsed=$(awk -v keys="^($CONF_KEYS)\$" "$DIR_OK_AWK"'
    function bad(msg) { if (!failed) { failed = 1; print "!" msg } }
    function branch_ok(v) {
      return v ~ /^[A-Za-z0-9_][A-Za-z0-9._\/-]*$/ && v !~ /\.\./ && v !~ /\/$/ && v !~ /\/\// && v !~ /\/\./ && v !~ /\.lock$/
    }
    BEGIN {
      c["version"] = "1"; c["base"] = "main"; c["cards_dir"] = "cards"; c["log_dir"] = "log"
      c["budget.XS"] = "35000"; c["budget.S"] = "70000"; c["budget.M"] = "100000"
      c["touch_ignore"] = ""; c["status_max_chars"] = "6000"; c["reviewer"] = "on"
    }
    { sub(/\r$/, "") }
    /^[ \t]*(#|$)/ { next }
    {
      i = index($0, "=")
      if (i == 0) { bad(":" NR ": expected key = value"); next }
      k = substr($0, 1, i - 1); v = substr($0, i + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (k !~ keys) { bad(":" NR ": unknown key"); next }
      c[k] = v
    }
    END {
      if (c["version"] != "1") bad(": unsupported version \047" c["version"] "\047 (this version of card understands version 1)")
      if (!dir_ok(c["cards_dir"])) bad(": cards_dir must be a relative path inside the repository")
      if (!dir_ok(c["log_dir"])) bad(": log_dir must be a relative path inside the repository")
      if (!branch_ok(c["base"])) bad(": base is not a valid branch name")
      if (c["cards_dir"] == c["log_dir"]) bad(": cards_dir and log_dir must differ")
      # 10000 is the harness limit for text a hook injects.
      if (c["status_max_chars"] !~ /^[0-9]+$/ || length(c["status_max_chars"]) > 5 || c["status_max_chars"] + 0 > 10000) bad(": status_max_chars must be a number up to 10000")
      if (c["reviewer"] != "on" && c["reviewer"] != "off") bad(": reviewer must be on or off")
      for (k in c) if (k ~ /^budget\./ && c[k] !~ /^[0-9]+$/) bad(": " k " must be a number of tokens")
      for (k in c) print k "=" c[k]
    }' workdeck.conf)
  case $parsed in
    '!'* | *"
!"*) die 2 "workdeck.conf$(printf '%s\n' "$parsed" | sed -n 's/^!//p' | head -1)" ;;
  esac
  CONF=$parsed
  BASE=$(conf_get base)
  CARDS_DIR=$(conf_get cards_dir)
  LOG_DIR=$(conf_get log_dir)
}

# sizes: the card sizes that have a budget, one per line.
sizes() {
  local line
  while IFS= read -r line; do
    case $line in
      budget.*) line=${line#budget.} && printf '%s\n' "${line%%=*}" ;;
    esac
  done <<CONF
$CONF
CONF
}

need_check() { [ -n "$(conf_get check)" ] || conf_die "check is not set"; }

cmd_conf() {
  [ "$#" -eq 1 ] || usage_die conf
  printf '%s\n' "$1" | grep -Eq "^($CONF_KEYS)\$" || die 2 "workdeck.conf has no key '$1'"
  [ "$1" != check ] || need_check
  conf_get "$1" || die 2 "workdeck.conf: no value for '$1'"
}

# --- cards ---

ID_RE='^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$'
readonly ID_RE

valid_id() { [[ $1 =~ $ID_RE ]]; }

# need_id <id>: every id passes here before it reaches a file name, a branch
# name or a pattern.
need_id() {
  if [ "$#" -lt 1 ] || ! valid_id "$1"; then die 2 "not a card id (expected something like AUTH-03)"; fi
}

# to_index: reads file paths, prints "<id><TAB><path>" for those named
# <id>.md or <id>-<slug>.md, in natural id order. The id always comes from
# the file name; lint checks that the front matter agrees.
to_index() {
  awk '{
    n = split($0, part, "/"); name = part[n]
    if (!match(name, /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?/)) next
    id = substr(name, 1, RLENGTH); rest = substr(name, RLENGTH + 1)
    if (rest == ".md" || rest ~ /^-.*\.md$/) print id "\t" $0
  }' | sort -t "$TAB" -k1,1V -k2,2
}

# wt_cards: the card files in the working tree, as an index.
wt_cards() {
  local f
  for f in "$CARDS_DIR"/*.md; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done | to_index
}

# card_path <id>: prints the path of the card. Exit 1 when the id is unknown
# or used by two files.
card_path() {
  local id=$1 index hits same
  index=$(wt_cards)
  hits=$(printf '%s\n' "$index" | ID="$id" awk -F '\t' '$1 == ENVIRON["ID"] { print $2 }')
  case $hits in
    '')
      same=$(printf '%s\n' "$index" | P="${id%%-*}-" awk -F '\t' 'index($1, ENVIRON["P"]) == 1 { printf " %s", $1 }')
      if [ -n "$same" ]; then
        die 1 "no card $id in $CARDS_DIR; cards with prefix ${id%%-*}:$same"
      fi
      die 1 "no card $id in $CARDS_DIR (no cards with prefix ${id%%-*}; run 'card list')"
      ;;
    *"
"*) die 1 "two cards have the id $id: $(printf '%s' "$hits" | tr '\n' ' '); run card lint" ;;
  esac
  printf '%s\n' "$hits"
}

# fm_get <file> <key>: one front matter value. Reads only between the first
# two --- lines.
fm_get() {
  K="$2" awk '
    BEGIN { k = ENVIRON["K"] ":" }
    { sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    index($0, k) == 1 {
      v = substr($0, length(k) + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", v)
      print v
      exit
    }' "$1"
}

# row_text <id>: the row of that id as written in its outline, the heading and
# the items, with control characters removed. Prints nothing when the id has
# a card file in the working tree or on a base branch, or no row. The row is
# the one deck_table lists: the first of that id, in the order of the outline
# paths. Run it inside $(...): with no base branch it ends there.
row_text() {
  local f row
  # deck_table does not list a row whose id is longer than 40 characters.
  [ "${#1}" -le 40 ] || return 0
  # The working tree first: a card that is there needs no base branch and
  # no git call, as in 0.1.
  wt_cards | ID="$1" awk -F '\t' '$1 == ENVIRON["ID"] { found = 1 } END { exit !found }' && return 0
  base_ref
  base_cards | ID="$1" awk -F '\t' '$1 == ENVIRON["ID"] { found = 1 } END { exit !found }' && return 0
  outline_files | while IFS= read -r f; do
    case $f in *[!A-Za-z0-9._/-]*) continue ;; esac
    row=$(if [ -f "$f" ]; then cat "$f"; else base_show "$f"; fi | ID="$1" awk '
      function clean(s) { gsub(/[\001-\037\177]/, "", s); return s }
      { sub(/\r$/, "") }
      NR == 1 { if ($0 != "---") exit; next }
      !closed { if ($0 == "---") closed = 1; next }
      /^## / {
        if (inside) exit
        h = substr($0, 4); gsub(/^[ \t]+|[ \t]+$/, "", h)
        i = index(h, " ")
        if (clean(i ? substr(h, 1, i - 1) : h) == ENVIRON["ID"]) { inside = 1; print clean($0) }
        next
      }
      inside && /^- / { print clean($0) }')
    [ -z "$row" ] || { printf '%s\n' "$row"; break; }
  done
}

cmd_show() {
  local path row
  need_id "$@"
  row=$(row_text "$1" 2>/dev/null)
  if [ -n "$row" ]; then
    printf 'row: no card file yet\n%s\n' "$row"
    return 0
  fi
  path=$(card_path "$1") || exit $?
  cat "$path"
}

# --- lint ---

# Shared awk helpers for the two lint programs. err() prints one finding;
# the caller sends stdout to stderr and uses the exit status.
LINT_LIB='
function err(msg) { print "card: " file ": " msg; bad = 1 }
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function has_control(s,   i, c) {
  for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (c < " " || c == "\177") return 1 }
  return 0
}
# front_matter_line: returns 1 when the line was stored in fm[].
function front_matter_line(   i, k, v, c) {
  if ($0 !~ /^[a-z_]+:( .*)?$/) { err("line " FNR ": front matter must be flat key: value lines"); return 0 }
  i = index($0, ":"); k = substr($0, 1, i - 1); v = trim(substr($0, i + 1))
  if (index(allowed, " " k " ") == 0) { err("line " FNR ": unknown front matter key " k); return 0 }
  if (k in fm) err("line " FNR ": " k " appears twice")
  c = substr(v, 1, 1)
  if (c == "\"" || c == "\047") err("line " FNR ": " k " is quoted; write the value bare")
  if (v == "|" || v == ">" || v ~ /^[|>][+-]$/) err("line " FNR ": " k " starts a multi-line value")
  if (c == "[" || c == "{") err("line " FNR ": " k " is a nested value")
  fm[k] = v
  return 1
}
function require(keys,   i, n, k) {
  n = split(keys, k, " ")
  for (i = 1; i <= n; i++) if (!(k[i] in fm)) err("front matter has no " k[i])
}
function reset() {
  file = (name != "" ? name : FILENAME); opened = 0; closed = 0; crlf = 0; cur = ""; body = 0
  split("", fm); split("", seen); split("", items)
}
{ cr = sub(/\r$/, "") }
FNR == 1 { finish(); reset(); crlf = cr; if ($0 == "---") opened = 1; next }
cr { crlf = 1 }
opened && !closed { if ($0 == "---") closed = 1; else front_matter_line(); next }
closed {
  body++
  if ($0 ~ /^## /) { cur = trim(substr($0, 4)); seen[cur] = 1 }
  else if (cur != "" && $0 ~ /^- *[^ ]/) items[cur]++
}
function shape_ok() {
  if (file == "") return 0
  if (crlf) err("has CRLF line endings; convert to LF")
  if (!opened) { err("does not start with a --- front matter line"); return 0 }
  if (!closed) { err("front matter is not closed with ---"); return 0 }
  return 1
}
'

lint_cards() {
  local known
  known=$(wt_cards | cut -f1 | tr '\n' ' ')
  [ "$#" -gt 0 ] || return 0
  awk -v sizes=" $(sizes | tr '\n' ' ')" -v known=" $known" \
    -v allowed=" id title size depends done " "$LINT_LIB"'
    function finish(   i, n, d, x, s, sec) {
      if (!shape_ok()) return
      n = split(file, d, "/"); match(d[n], /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?/); fid = substr(d[n], 1, RLENGTH)
      if (fid in first) err("id " fid " is also used by " first[fid]); else first[fid] = file
      require("id title size depends done")
      if ("id" in fm) {
        if (fm["id"] !~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/) err("id is not valid (expected something like AUTH-03)")
        else if (fm["id"] != fid) err("id " fm["id"] " does not match the file name")
      }
      if ("title" in fm) {
        if (fm["title"] == "") err("title is empty")
        if (length(fm["title"]) > 80) err("title is longer than 80 characters")
        if (has_control(fm["title"])) err("title has a control character")
      }
      if ("size" in fm && index(sizes, " " fm["size"] " ") == 0) err("size " fm["size"] " has no budget in workdeck.conf")
      if ("done" in fm && fm["done"] != "true" && fm["done"] != "false") err("done must be true or false")
      deps[fid] = ""
      if (fm["depends"] != "") {
        n = split(fm["depends"], d, ",")
        for (i = 1; i <= n; i++) {
          x = trim(d[i])
          if (x !~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/) err("depends has an invalid id")
          else if (index(known, " " x " ") == 0) err("depends on " x ", which is not a card")
          else deps[fid] = deps[fid] " " x
        }
      }
      n = split("Read Touch Tests Acceptance", sec, " ")
      for (i = 1; i <= n; i++) {
        s = sec[i]
        if (!(s in seen)) err("has no ## " s " section")
        else if (items[s] == 0 && !(s == "Read" && fm["size"] == "XS")) err("## " s " has no items (an item is a line that starts with \"- \")")
      }
    }
    END {
      finish()
      # Remove cards whose dependencies are all removed; what stays is a cycle
      # or depends on one.
      do {
        changed = 0
        for (id in deps) {
          if (id in gone) continue
          free = 1; n = split(deps[id], d, " ")
          for (i = 1; i <= n; i++) if ((d[i] in deps) && !(d[i] in gone)) free = 0
          if (free) { gone[id] = 1; changed = 1 }
        }
      } while (changed)
      for (id in deps) if (!(id in gone)) { file = first[id]; err("is in, or depends on, a dependency cycle") }
      exit bad
    }' "$@"
}

lint_logs() {
  [ "$#" -gt 0 ] || return 0
  awk -v allowed=" card date outcome branch pr size budget_tokens baseline_tokens peak_tokens growth_tokens compacted " "$LINT_LIB"'
    function measured(k) {
      if ((k in fm) && fm[k] !~ /^[0-9]+$/ && fm[k] != "unknown") err(k " must be a number or unknown")
    }
    function finish(   i, n, d, name, sec) {
      if (!shape_ok()) return
      n = split(file, d, "/"); name = d[n]
      if (name !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[A-Z][A-Z0-9]*-[0-9]+[a-z]?-[0-9]+\.md$/) {
        err("is not named <date>-<id>-<n>.md"); return
      }
      require("card date outcome branch size budget_tokens baseline_tokens peak_tokens growth_tokens compacted")
      sub(/-[0-9]+\.md$/, "", name)
      if (("date" in fm) && fm["date"] != substr(name, 1, 10)) err("date " fm["date"] " does not match the file name")
      if (("card" in fm) && fm["card"] != substr(name, 12)) err("card " fm["card"] " does not match the file name")
      if (("outcome" in fm) && fm["outcome"] !~ /^(done|split|blocked|review-fixes)$/) err("outcome must be done, split, blocked or review-fixes")
      measured("budget_tokens"); measured("baseline_tokens"); measured("peak_tokens"); measured("growth_tokens")
      if (("compacted" in fm) && fm["compacted"] !~ /^(true|false|unknown)$/) err("compacted must be true, false or unknown")
      if (("pr" in fm) && fm["pr"] !~ /^[0-9]*$/) err("pr must be a number")
      if (body > 40) err("is longer than 40 lines after the front matter (" body ")")
      n = split("Done Tests Deviations Follow-ups", sec, " ")
      for (i = 1; i <= n; i++) if (!(sec[i] in seen)) err("has no ## " sec[i] " section")
    }
    END { finish(); exit bad }' "$@"
}

cmd_lint() {
  local f rc=0 index
  need_check
  index=$(wt_cards)
  for f in "$CARDS_DIR"/*.md; do
    [ -f "$f" ] || continue
    [ "$f" != "$CARDS_DIR/REVIEW.md" ] || continue
    printf '%s\n' "$index" | F="$f" awk -F '\t' '$2 == ENVIRON["F"] { found = 1 } END { exit !found }' && continue
    printf 'card: %s: file name does not start with a card id\n' "$f" >&2
    rc=1
  done

  # Card and log paths cannot contain spaces or glob characters by the time
  # they are in an index or match the log name, but quote through set -- anyway.
  set --
  while IFS="$TAB" read -r _ f; do
    [ -n "$f" ] && set -- "$@" "$f"
  done <<INDEX
$index
INDEX
  lint_cards "$@" >&2 || rc=1

  set --
  for f in "$LOG_DIR"/*.md; do
    [ -f "$f" ] && set -- "$@" "$f"
  done
  lint_logs "$@" >&2 || rc=1
  return "$rc"
}

# --- deck ---

# Reads front matter and prints "<path> <size> <title> <depends> <done>",
# tab-separated. Control characters are removed and the title is capped,
# because these fields are printed into an agent's context. With -v name=<path>
# it reads one card from stdin.
META_AWK='
  function flush() {
    if (file == "") return
    # A size is printed only when it looks like one.
    size = fm["size"]
    if (size != "" && (size !~ /^[A-Z][A-Z0-9]*$/ || length(size) > 8)) size = "?"
    print file "\t" size "\t" substr(fm["title"], 1, 80) "\t" fm["depends"] "\t" fm["done"]
  }
  FNR == 1 { flush(); file = (name != "" ? name : FILENAME); split("", fm); infm = 0 }
  { sub(/\r$/, "") }
  FNR == 1 { infm = ($0 == "---"); next }
  infm && $0 == "---" { infm = 0; next }
  infm {
    i = index($0, ":")
    if (i == 0) next
    k = substr($0, 1, i - 1); v = substr($0, i + 1)
    gsub(/[\001-\037\177]/, "", v); gsub(/^ +| +$/, "", v)
    if (!(k in fm)) fm[k] = v
  }
  END { flush() }'

wt_meta() {
  [ "$#" -gt 0 ] || return 0
  awk "$META_AWK" "$@"
}

# Set by base_ref. Emptied here, so a value of the same name in the
# environment is not taken for one that base_ref set.
BASE_REF=""
BASE_REFS=""

# base_ref: sets BASE_REF (origin/<base> when it exists, else the local base
# branch) and BASE_REFS, every base ref that state is read from: both of them
# when they point at different commits. A merge made locally and not pushed
# counts, and so does one fetched while the local branch is behind; done
# never reverts, so done on either is done. Call it from the main shell, not
# inside $(...), so that die ends the command.
base_ref() {
  local remote local_
  [ -z "${BASE_REF-}" ] || return 0
  remote=$(g rev-parse -q --verify "refs/remotes/origin/$BASE" 2>/dev/null) || remote=""
  local_=$(g rev-parse -q --verify "refs/heads/$BASE" 2>/dev/null) || local_=""
  if [ -n "$remote" ]; then
    BASE_REF="refs/remotes/origin/$BASE"
  elif [ -n "$local_" ]; then
    BASE_REF="refs/heads/$BASE"
  else
    die 2 "base branch '$BASE' not found; set base in workdeck.conf, or make a first commit"
  fi
  BASE_REFS=$BASE_REF
  if [ -n "$remote" ] && [ -n "$local_" ] && [ "$remote" != "$local_" ]; then
    BASE_REFS="$BASE_REF refs/heads/$BASE"
  fi
}

# base_done: paths of the cards that are done on a base branch. One git call
# per base ref for the whole deck. A card counts only when "done: true" sits
# between a --- on line 1 and the next ---, so text in a card body cannot
# flip it.
# Limitation: a card file renamed between the two base refs is looked up under
# both names and counts under the one that says done.
base_done() {
  local ref
  for ref in $BASE_REFS; do
    g grep -n -e '^done:[[:space:]]*true[[:space:]]*$' -e '^---$' "$ref" -- "$CARDS_DIR" 2>/dev/null |
      P="$ref:" awk '
        BEGIN { p = ENVIRON["P"] }
        index($0, p) == 1 { $0 = substr($0, length(p) + 1) }
        !match($0, /:[0-9]+:(---|done:[ \t]*true[ \t]*)$/) { next }
        {
          path = substr($0, 1, RSTART - 1); rest = substr($0, RSTART + 1)
          if (rest ~ /---$/) { if (++seps[path] == 1 && rest + 0 != 1) bad[path] = 1 }
          else if (seps[path] == 1 && !(path in bad)) print path
        }'
  done
}

# base_cards: the card files on the base refs, as an index.
base_cards() {
  local ref
  for ref in $BASE_REFS; do
    g ls-tree --name-only "$ref" "$CARDS_DIR/" 2>/dev/null
  done | sort -u | to_index
}

# base_show <path>: the file from the first base ref that has it.
base_show() {
  local ref
  for ref in $BASE_REFS; do
    g show "$ref:$1" 2>/dev/null && return 0
  done
  return 1
}

# card_branches: "<id> <ref>", tab-separated, for every local or remote
# branch named card/<id> or card/<id>-<slug>. Local branches come first.
card_branches() {
  g for-each-ref --format='%(refname)' refs/heads/card refs/remotes 2>/dev/null | awk '
    {
      name = $0
      if (index(name, "refs/heads/") == 1) name = substr(name, 12)
      else { name = substr(name, 14); name = substr(name, index(name, "/") + 1) }
      if (index(name, "card/") != 1) next
      name = substr(name, 6)
      if (!match(name, /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?/)) next
      c = substr(name, RLENGTH + 1, 1)
      if (c == "-" || c == "") print substr(name, 1, RLENGTH) "\t" $0
    }'
}

# has_blocked <id> <ref>: does the card carry a ## Blocked section on that
# branch? The current branch is read from the working tree.
has_blocked() {
  local id=$1 ref=$2 f
  if [ "$ref" = "$(g symbolic-ref -q HEAD)" ]; then
    for f in "$CARDS_DIR/$id.md" "$CARDS_DIR/$id"-*.md; do
      [ -f "$f" ] && grep -q '^## Blocked' "$f" && return 0
    done
    return 1
  fi
  g grep -q -e '^## Blocked' "$ref" -- "$CARDS_DIR/$id.md" "$CARDS_DIR/$id-*.md" 2>/dev/null
}

# deck_table gathers everything it needs as tagged lines and joins them in one
# awk pass. The tags: W a card file in the working tree, G a card file on a
# base ref, D a path that is done on a base ref, M front matter of one card,
# B an id that has a branch, K an id whose branch says Blocked, P an id with
# an open pull request, R a row of an outline.
#
# deck_table: one line per card in natural id order, tab-separated:
# "<state> <id> <size> <title> <why> <mark>". <why> lists unmet dependencies.
# The deck is the union of the cards on the base branch and in the working
# tree, and of the rows whose id has no card file in either; <mark> is [row]
# for those. Needs BASE_REF.
deck_table() {
  local wt base tagged f p id ref seen
  wt=$(wt_cards)
  base=$(base_cards)
  tagged=$(
    printf '%s\n' "$wt" | awk 'NF { print "W\t" $0 }'
    printf '%s\n' "$base" | awk 'NF { print "G\t" $0 }'
  )
  set --
  while IFS="$TAB" read -r _ f; do
    [ -n "$f" ] && set -- "$@" "$f"
  done <<INDEX
$wt
INDEX
  {
    printf '%s\n' "$tagged"
    base_done | awk '{ print "D\t" $0 }'
    wt_meta "$@" | awk '{ print "M\t" $0 }'
    # One git show per card that is on base but not in the working
    # tree. That set is normally empty; batch with cat-file if it ever is not.
    printf '%s\n' "$tagged" | awk -F '\t' '$1 == "W" { w[$2] = 1 } $1 == "G" && !($2 in w) { print $3 }' |
      while IFS= read -r p; do
        base_show "$p" | awk -v name="$p" "$META_AWK" | awk '{ print "M\t" $0 }'
      done
    seen=" "
    card_branches | while IFS="$TAB" read -r id ref; do
      case $seen in *" $id "*) continue ;; esac
      seen="$seen$id "
      printf 'B\t%s\n' "$id"
      has_blocked "$id" "$ref" && printf 'K\t%s\n' "$id"
    done
    printf '%s\n' "$PR_IDS" | awk 'NF { print "P\t" $0 }'
    # Each outline is read once. Its findings are for card plan, not for here.
    outlines | awk -F '\t' '$1 == "R" { print "R\t" $3 "\t" $4 "\t" $5 "\t" $6 }'
  } | awk -F '\t' '
    function seen(list, x) { return index(" " list " ", " " x " ") > 0 }
    $1 == "W" { if (!($2 in wpath)) wpath[$2] = $3; ids[$2] = 1 }
    $1 == "G" { if (!($2 in gpath)) gpath[$2] = $3; ids[$2] = 1 }
    $1 == "D" { bdone[$2] = 1 }
    $1 == "M" { size[$2] = $3; title[$2] = $4; deps[$2] = $5; if ($6 == "true") wdone[$2] = 1 }
    $1 == "B" { branch[$2] = 1 }
    $1 == "K" { blocked[$2] = 1 }
    $1 == "P" { review[$2] = 1 }
    # The first row of an id counts, in the order of the outline paths; card
    # plan reports the second. The size is cut as META_AWK cuts it.
    $1 == "R" && $2 ~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/ && !($2 in row) {
      row[$2] = 1; p = SUBSEP $2
      size[p] = (length($3) > 8 ? "?" : $3); title[p] = $4; deps[p] = $5
    }
    END {
      for (id in ids) {
        path[id] = (id in wpath) ? wpath[id] : gpath[id]
        if (id in gpath) { if (gpath[id] in bdone) isdone[id] = 1 }
        # A card that is only in the working tree is done on its own word, unless
        # it has a branch or a pull request: then done: true only means that
        # handoff ran, and the card is not merged yet.
        else if ((wpath[id] in wdone) && !(id in branch) && !(id in review)) isdone[id] = 1
      }
      # A row whose id has no card file is a card that is not done.
      for (id in row) if (!(id in ids)) { ids[id] = 1; path[id] = SUBSEP id; isrow[id] = 1 }
      for (id in ids) {
        p = path[id]; why = ""
        m = split(deps[p], d, ",")
        for (j = 1; j <= m; j++) {
          x = d[j]; gsub(/ /, "", x)
          if (x != "" && x !~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/) x = "?"
          if (!(id in isrow)) {
            if (x != "" && !(x in isdone)) why = why (why == "" ? "" : " ") x
            continue
          }
          # A row is new input: an id longer than a row id may be is not
          # printed, and no id is printed twice.
          if (length(x) > 40) x = "?"
          if (x != "" && !(x in isdone) && !seen(why, x)) why = why (why == "" ? "" : " ") x
          # A row also waits for what a split left of its dependency: the
          # same id with a letter, or with another letter. Not for itself.
          sub(/[a-z]$/, "", x)
          for (c = 97; c <= 122; c++) {
            y = x sprintf("%c", c)
            if (y != id && (y in ids) && !(y in isdone) && !seen(why, y)) why = why (why == "" ? "" : " ") y
          }
        }
        if (id in isdone) state = "done"
        else if (id in review) state = "review"
        else if ((id in branch) && (id in blocked)) state = "blocked"
        else if (id in branch) state = "active"
        else if (why == "") state = "ready"
        else state = "waiting"
        print id "\t" state "\t" size[p] "\t" title[p] "\t" why "\t" ((id in isrow) ? "[row]" : "")
      }
    }' | sort -t "$TAB" -k1,1V | awk -F '\t' '{ print $2 "\t" $1 "\t" $3 "\t" $4 "\t" $5 "\t" $6 }'
}

cmd_next() {
  local table
  sync_remote
  base_ref
  table=$(deck_table)
  printf '%s\n' "$table" | D="$CARDS_DIR" awk -F '\t' '
    NF { n++ }
    $1 == "ready" { print $2, $3, $4 ($6 == "" ? "" : " " $6); found = 1; exit }
    $1 == "waiting" { open[++o] = $2 " waiting on " $5 }
    $1 == "active" || $1 == "blocked" || $1 == "review" { open[++o] = $2 " " $1 }
    $1 == "active" || $1 == "blocked" { held = 1 }
    END {
      if (found) exit 0
      if (n == 0) print "no cards in " ENVIRON["D"] "; create one with: card new <id> <title>"
      else if (o == 0) print "every card is done"
      else {
        print "no card is ready"
        for (i = 1; i <= o; i++) print "  " open[i]
        if (held) {
          print "active and blocked cards have a branch named card/<id> or card/<id>-<slug>; deleting it releases the card."
          print "List them: git branch -a --list \047card/*\047 (card list --fetch drops stale remote refs)"
        }
      }
      exit 1
    }'
}

cmd_list() {
  sync_remote
  base_ref
  deck_table | awk -F '\t' '{ printf "%-8s %-12s %-3s %s%s\n", $1, $2, $3, $4, ($6 == "" ? "" : " " $6) }'
}

# --- remote ---

# id_of_branch: reads branch names, prints the card id of each one named
# card/<id> or card/<id>-<slug>.
id_of_branch() {
  awk '{
    if (index($0, "card/") != 1) next
    name = substr($0, 6)
    if (!match(name, /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?/)) next
    c = substr(name, RLENGTH + 1, 1)
    if (c == "-" || c == "") print substr(name, 1, RLENGTH)
  }'
}

# sync_remote: with --fetch, update remote-tracking refs and read the head
# branches of open pull requests into PR_IDS. The only network access in card.
# Prompts are disabled so a missing credential fails instead of hanging.
PR_IDS=""
sync_remote() {
  local heads
  [ "$FETCH" -eq 1 ] || return 0
  g remote get-url origin >/dev/null 2>&1 || return 0
  GIT_TERMINAL_PROMPT=0 g fetch --prune --quiet origin 2>/dev/null ||
    printf 'card: git fetch failed; state comes from the refs already here\n' >&2
  if heads=$(GH_PROMPT_DISABLED=1 gh pr list --state open --limit 500 --json headRefName --jq '.[].headRefName' 2>/dev/null); then
    PR_IDS=$(printf '%s\n' "$heads" | id_of_branch)
  else
    printf 'card: gh is missing or not signed in; cards in review are shown as active\n' >&2
  fi
}

# --- status ---

# last_log_done <id>: the Done section of the newest log entry for the card.
last_log_done() {
  local f last=""
  for f in "$LOG_DIR"/*-"$1"-[0-9]*.md; do
    [ -f "$f" ] || continue
    # The name is printed, so it must be a plain log name.
    case ${f##*/} in *[!0-9A-Za-z.-]*) continue ;; esac
    last="$last$f
"
  done
  last=$(printf '%s' "$last" | sort -V | tail -1)
  [ -n "$last" ] || return 0
  printf 'Last log for %s (%s):\n' "$1" "${last##*/}"
  awk '
    /^## / { on = ($0 == "## Done"); next }
    on && NF { gsub(/[\001-\037\177]/, ""); print "  " substr($0, 1, 200) }' "$last"
}

# cmd_status prints front matter fields and one log section, never a card
# body and never the name of a branch other than the current one: this text
# is injected into an agent's context at session start.
cmd_status() {
  local table branch id out max note
  sync_remote
  base_ref
  table=$(deck_table)
  branch=$(g symbolic-ref -q --short HEAD) || branch=""
  id=$(printf '%s\n' "$branch" | id_of_branch)
  out=$(
    if [ -z "$branch" ]; then
      echo 'WorkDeck: detached HEAD (no card)'
    elif [ -z "$id" ]; then
      printf 'WorkDeck: on %s (no card)\n' "$branch"
    else
      printf '%s\n' "$table" | B="$branch" I="$id" awk -F '\t' '
        $2 == ENVIRON["I"] { printf "WorkDeck: on %s: %s %s %s (%s)\n", ENVIRON["B"], $2, $3, $4, $1; found = 1 }
        END { if (!found) printf "WorkDeck: on %s: no card %s in the deck\n", ENVIRON["B"], ENVIRON["I"] }'
    fi
    if [ -z "$table" ]; then
      echo 'No cards yet. Create one with: card new <id> <title>, or use /workdeck:quick.'
    else
      printf '%s\n' "$table" | awk -F '\t' '
        $1 == "active" || $1 == "review" || $1 == "blocked" {
          if (!n++) print "In progress:"
          printf "  %-8s %-12s %-3s %s\n", $1, $2, $3, $4
        }
        $1 == "ready" && next_ready == "" { next_ready = $2 " " $3 " " $4 }
        END { print "Next ready: " (next_ready == "" ? "none" : next_ready) }'
    fi
    [ -z "$id" ] || last_log_done "$id"
  )
  max=$(conf_get status_max_chars)
  note='[truncated: longer than status_max_chars]'
  if [ "${#out}" -gt "$max" ]; then
    if [ "$max" -gt "$((${#note} + 1))" ]; then
      printf '%s\n%s\n' "${out:0:$((max - ${#note} - 1))}" "$note"
    else
      printf '%s\n' "${out:0:$max}"
    fi
  else
    printf '%s\n' "$out"
  fi
}

# --- write side ---

# The template lives here, not in templates/, because card must work as a
# single downloaded file.
cmd_new() {
  local id="" title="" have=0 size=S depends=""
  while [ "$#" -gt 0 ]; do
    case $1 in
      --size | --depends)
        [ "$#" -ge 2 ] || die 2 "$1 needs a value"
        if [ "$1" = --size ]; then size=$2; else depends=$2; fi
        shift 2
        ;;
      --*) usage_die new "unknown option $1" ;;
      *)
        case $have in
          0) id=$1 ;;
          1) title=$1 ;;
          *) usage_die new "too many arguments; quote the title" ;;
        esac
        have=$((have + 1))
        shift
        ;;
    esac
  done
  [ "$have" -eq 2 ] || usage_die new
  write_card "$id" "$title" "$size" "$depends"
}

# title_fault <title>: prints why card lint would reject the title, or
# nothing.
title_fault() {
  [ -n "$1" ] || { echo "the title is empty"; return; }
  [ "${#1}" -le 80 ] || { echo "the title is longer than 80 characters (${#1})"; return; }
  case $1 in
    *[[:cntrl:]]*) echo "the title has a control character or a line break" ;;
    \"* | \'*) echo "the title starts with a quote, which card lint rejects" ;;
    "["* | "{"*) echo "the title starts with [ or {, which card lint rejects as a nested value" ;;
    "|" | ">" | [\|\>][+-]) echo "the title is a multi-line marker, which card lint rejects" ;;
  esac
}

# depends_list <text>: the ids of a comma-separated list, one per line. Exit
# 1 when one of them is not a card id.
depends_list() {
  local d
  printf '%s' "$1" | tr ',' '\n' | sed 's/^ *//; s/ *$//; /^$/d' | while IFS= read -r d || [ -n "$d" ]; do
    valid_id "$d" || exit 1
    printf '%s\n' "$d"
  done
}

# write_card <id> <title> <size> <depends>: checks the four values, creates
# the card file with empty sections and prints its path.
write_card() {
  local id=$1 title=$2 size=$3 depends=$4 slug path existing fault
  need_id "$id"
  fault=$(title_fault "$title")
  [ -z "$fault" ] || die 2 "$fault"
  sizes | grep -qxF -- "$size" || die 2 "size $size has no budget in workdeck.conf"
  depends=$(depends_list "$depends") || die 2 "--depends takes card ids separated by commas"
  depends=$(printf '%s' "$depends" | tr '\n' ',' | sed 's/,/, /g')

  existing=$(wt_cards | ID="$id" awk -F '\t' '$1 == ENVIRON["ID"] { print $2; exit }')
  [ -z "$existing" ] || die 1 "$existing: card $id already exists"

  # At most 40 characters, cut at a word where there is one.
  slug=$(printf '%s\n' "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//' |
    awk '{
      if (length($0) > 40) { s = substr($0, 1, 41); if (!sub(/-[^-]*$/, "", s)) s = substr($0, 1, 40); $0 = s }
      print
    }')
  path="$CARDS_DIR/$id${slug:+-$slug}.md"
  # The file is not written through a link, which could name a file outside
  # the repository. A directory on the way to it is not looked at.
  [ ! -L "$path" ] || die 1 "$path is a symbolic link"
  mkdir -p "$CARDS_DIR" || die 2 "cannot create $CARDS_DIR"
  {
    printf -- '---\nid: %s\ntitle: %s\nsize: %s\ndepends:%s\ndone: false\n---\n' \
      "$id" "$title" "$size" "${depends:+ $depends}"
    printf '\n## Read\n\n## Touch\n\n## Tests\n\n## Acceptance\n\n## Out of scope\n\n## Notes\n'
  } > "$path" || die 2 "cannot write $path"
  printf '%s\n' "$path"
}

cmd_done() {
  local path tmp rc
  need_id "$@"
  path=$(card_path "$1") || exit $?
  case $(fm_get "$path" done) in
    true) return 0 ;;
    false) ;;
    *) die 1 "$path: front matter has no 'done: false' line; run card lint" ;;
  esac
  tmp=$(mktemp) || die 2 "cannot create a temporary file"
  # Written back with cat so the file keeps its mode.
  awk '
    NR == 1 && /^---\r?$/ { infm = 1; print; next }
    infm && /^---\r?$/ { infm = 0 }
    infm && /^done:[ \t]*false[ \t]*\r?$/ { sub(/false/, "true") }
    { print }' "$path" > "$tmp" && cat "$tmp" > "$path"
  rc=$?
  rm -f "$tmp"
  [ "$rc" -eq 0 ] || die 2 "$path: cannot write"
}

# --- gates ---

# section_items <file> <section>: the "- " items of one section, dash removed.
section_items() {
  S="$2" awk '
    BEGIN { h = "## " ENVIRON["S"] }
    { sub(/\r$/, "") }
    /^## / { t = $0; sub(/[ \t]+$/, "", t); on = (t == h); next }
    on && /^- */ { sub(/^- */, ""); if ($0 != "") print }' "$1"
}

# fork_point: the commit where the current branch left the base branch.
# With a remote, a branch may have been cut from a local base that is ahead of
# origin/<base>; measuring from the remote one would blame this branch for
# every unpushed commit. So take whichever merge base is later.
fork_point() {
  local a b=""
  a=$(g merge-base HEAD "$BASE_REF" 2>/dev/null)
  if g rev-parse -q --verify "refs/heads/$BASE" >/dev/null 2>&1; then
    b=$(g merge-base HEAD "refs/heads/$BASE" 2>/dev/null)
  fi
  if [ -z "$a" ] || { [ -n "$b" ] && g merge-base --is-ancestor "$a" "$b"; }; then a=$b; fi
  [ -n "$a" ] || die 2 "the current branch shares no history with $BASE"
  printf '%s\n' "$a"
}

# diff_files <fork point>: every path that differs from the fork point,
# including uncommitted and untracked files, because handoff runs the gates
# before it commits.
diff_files() {
  {
    g diff --name-only --no-renames "$1" --
    g ls-files --others --exclude-standard
  } | sort -u
}

# changed_files <fork point>: diff_files without the files under cards_dir
# and log_dir: the card and its log always change.
changed_files() {
  diff_files "$1" | C="$CARDS_DIR/" L="$LOG_DIR/" awk '
    index($0, ENVIRON["C"]) != 1 && index($0, ENVIRON["L"]) != 1'
}

# touch_patterns: reads Touch or touch_ignore entries, prints each as a
# pattern. A trailing / covers the directory, and a leading / or ./ is
# ignored.
touch_patterns() { sed 's|^\./||; s|^/||; s|/$|/*|; /^$/d'; }

# matches_any <path> <patterns, one per line>: shell case patterns, so "*"
# also matches "/". The pattern is only ever a pattern; nothing is evaluated.
matches_any() {
  local pat
  while IFS= read -r pat; do
    [ -n "$pat" ] || continue
    # shellcheck disable=SC2254
    case $1 in $pat) return 0 ;; esac
  done <<PATTERNS
$2
PATTERNS
  return 1
}

cmd_touched() {
  local path fp entries ignore files f pat stray="" unused=""
  need_id "$@"
  path=$(card_path "$1") || exit $?
  base_ref
  fp=$(fork_point) || exit $?
  # The text after the first space of an entry is a comment.
  entries=$(section_items "$path" Touch | sed 's/ .*//' | touch_patterns)
  ignore=$(conf_get touch_ignore | tr ',' '\n' | sed 's/^ *//; s/ *$//' | touch_patterns)
  files=$(changed_files "$fp")

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    matches_any "$f" "$ignore" && continue
    matches_any "$f" "$entries" || stray="$stray  $f
"
  done <<FILES
$files
FILES

  while IFS= read -r pat; do
    [ -n "$pat" ] || continue
    while IFS= read -r f; do
      # shellcheck disable=SC2254
      case $f in $pat) continue 2 ;; esac
    done <<FILES
$files
FILES
    unused="$unused  $pat
"
  done <<ENTRIES
$entries
ENTRIES

  [ -z "$unused" ] || printf 'in Touch but not changed:\n%s' "$unused"
  [ -n "$stray" ] || return 0
  printf 'changed but not in Touch (revert it, or add it to Touch with a reason):\n%s' "$stray"
  return 1
}

# cmd_tests: the tests gate. Each Tests line and each line of the changed
# files is lowercased and stripped to letters and digits; the line passes
# when it is found inside any file line. A presence check, nothing more.
cmd_tests() {
  local path fp lines f
  need_id "$@"
  path=$(card_path "$1") || exit $?
  base_ref
  fp=$(fork_point) || exit $?
  lines=$(section_items "$path" Tests)
  [ -n "$lines" ] || die 1 "$path: the Tests section has no items"
  set --
  while IFS= read -r f; do
    # ./ keeps awk from reading a name like n=0 as an assignment.
    [ -f "$f" ] && set -- "$@" "./$f"
  done <<FILES
$(changed_files "$fp")
FILES
  # /dev/null keeps awk from waiting on stdin when nothing changed.
  LINES="$lines" awk '
    function norm(s) { s = tolower(s); gsub(/[^a-z0-9]/, "", s); return s }
    BEGIN { n = split(ENVIRON["LINES"], raw, "\n"); for (i = 1; i <= n; i++) need[i] = norm(raw[i]) }
    {
      h = norm($0)
      if (h == "") next
      for (i = 1; i <= n; i++) if (!(i in found) && need[i] != "" && index(h, need[i])) found[i] = 1
    }
    END {
      for (i = 1; i <= n; i++) {
        if (need[i] == "") miss = miss "  " raw[i] " (no letters or digits to match)\n"
        else if (!(i in found)) miss = miss "  " raw[i] "\n"
      }
      if (miss == "") exit 0
      printf "no test with this name on one line of the files changed (nested names are not joined: use the innermost name, or edit the card line):\n%s", miss
      exit 1
    }' /dev/null "$@"
}

# --- logs ---

# session_compacted: true, false or unknown. The pre-compact hook leaves a
# marker file named after the session in <git-dir>/workdeck/. The session id
# comes from the environment and becomes part of a file name, so it is
# checked first.
session_compacted() {
  local session=${WORKDECK_SESSION-} dir
  case $session in
    '' | *[!A-Za-z0-9_-]*)
      echo unknown
      return 0
      ;;
  esac
  dir=$(g rev-parse --absolute-git-dir 2>/dev/null) || { echo unknown; return 0; }
  if [ -e "$dir/workdeck/$session.compacted" ]; then echo true; else echo false; fi
}

cmd_stats() {
  local f s
  set --
  for f in "$LOG_DIR"/*.md; do
    [ -f "$f" ] && set -- "$@" "$f"
  done
  if [ "$#" -eq 0 ]; then
    echo "no session logs in $LOG_DIR"
    return 0
  fi
  # Sizes in budget order, as "size:budget" words.
  s=$(sizes | while IFS= read -r s; do printf '%s %s\n' "$(conf_get "budget.$s")" "$s"; done |
    sort -n | awk '{ printf "%s:%s ", $2, $1 }')
  awk -v sizes="$s" '
    function flush(   s, g, c) {
      s = rec["size"]
      if (s != "") {
        if (!(s in count)) extra[++nextra] = s
        count[s]++; total++
        g = rec["growth_tokens"]
        if (g ~ /^[0-9]+$/) { val[s, ++nval[s]] = g + 0; measured++ }
        c = rec["compacted"]
        if (c == "true") comp[s]++
        if (c == "true" || c == "false") known[s]++
      }
      split("", rec)
    }
    function row(s, budget,   n, i, j, t, med, max) {
      n = nval[s]
      # Insertion sort: a size has at most a few hundred sessions.
      for (i = 2; i <= n; i++) {
        t = val[s, i]
        for (j = i - 1; j >= 1 && val[s, j] > t; j--) val[s, j + 1] = val[s, j]
        val[s, j + 1] = t
      }
      med = "-"; max = "-"
      if (n > 0) {
        max = val[s, n]
        med = (n % 2) ? val[s, (n + 1) / 2] : int((val[s, n / 2] + val[s, n / 2 + 1]) / 2)
      }
      printf "%-6s %8d %8s %8s %8s %9s\n", s, count[s], budget, med, max, \
        (known[s] > 0 ? int(comp[s] * 100 / known[s] + 0.5) "%" : "-")
    }
    BEGIN {
      n = split(sizes, w, " ")
      for (i = 1; i <= n; i++) { split(w[i], p, ":"); order[i] = p[1]; budget[p[1]] = p[2]; count[p[1]] = 0 }
    }
    FNR == 1 { flush(); infm = ($0 == "---"); next }
    infm && $0 == "---" { infm = 0; next }
    infm {
      i = index($0, ":")
      if (i) { k = substr($0, 1, i - 1); v = substr($0, i + 1); gsub(/^ +| +$|\r$/, "", v); rec[k] = v }
    }
    END {
      flush()
      printf "%-6s %8s %8s %8s %8s %9s\n", "size", "sessions", "budget", "median", "max", "compacted"
      for (i = 1; i <= n; i++) row(order[i], budget[order[i]])
      for (i = 1; i <= nextra; i++) row(extra[i], "-")
      if (total > measured) printf "%d of %d sessions have no measurement (growth_tokens: unknown)\n", total - measured, total
    }' "$@"
}

cmd_log_new() {
  local id outcome path size budget date n=1 file branch
  [ "$#" -eq 2 ] || usage_die log-new
  id=$1
  outcome=$2
  need_id "$id"
  case $outcome in
    done | split | blocked | review-fixes) ;;
    *) usage_die log-new "outcome must be done, split, blocked or review-fixes" ;;
  esac
  path=$(card_path "$id") || exit $?
  size=$(fm_get "$path" size)
  budget=$(conf_get "budget.$size") || budget=unknown
  branch=$(g symbolic-ref -q --short HEAD) || branch=detached
  date=$(date +%Y-%m-%d)
  while [ -e "$LOG_DIR/$date-$id-$n.md" ]; do n=$((n + 1)); done
  file="$LOG_DIR/$date-$id-$n.md"
  mkdir -p "$LOG_DIR" || die 2 "cannot create $LOG_DIR"
  {
    printf -- '---\ncard: %s\ndate: %s\noutcome: %s\nbranch: %s\nsize: %s\nbudget_tokens: %s\n' \
      "$id" "$date" "$outcome" "$branch" "$size" "$budget"
    measure "${WORKDECK_TRANSCRIPT-}" | awk '
      $1 == "baseline" || $1 == "peak" || $1 == "growth" { v[$1] = $2 }
      END {
        if (!("baseline" in v)) v["baseline"] = v["peak"] = v["growth"] = "unknown"
        printf "baseline_tokens: %s\npeak_tokens: %s\ngrowth_tokens: %s\n", v["baseline"], v["peak"], v["growth"]
      }'
    printf 'compacted: %s\n---\n' "$(session_compacted)"
    printf '\n## Done\n\n## Tests\n\n## Deviations\n\n## Follow-ups\n'
  } > "$file" || die 2 "cannot write $file"
  printf '%s\n' "$file"
}

# --- tokens ---

# measure <transcript>: prints "baseline N", "peak N", "growth N", or the one
# word "unknown". The context size of a turn is input_tokens +
# cache_creation_input_tokens + cache_read_input_tokens from the usage object
# of a main-session assistant line.
#
# The transcript format is not a documented interface, so anything that does
# not look right is skipped and a file with no usable line is "unknown".
# Two traps: usage.iterations[] repeats the same keys, so only the text before
# the first "[" is read; and tool results carry their own usage object in
# user lines, so only assistant lines count.
measure() {
  if [ ! -f "$1" ] || [ ! -r "$1" ]; then
    echo unknown
    return 0
  fi
  grep -F '"role":"assistant"' "$1" 2>/dev/null | awk '
    function num(u, key,   i, s) {
      i = index(u, "\"" key "\":")
      if (!i) return -1
      s = substr(u, i + length(key) + 3, 12)
      return (s ~ /^[0-9]/) ? s + 0 : -1
    }
    {
      if (index($0, "\"isSidechain\":true") || !index($0, "\"type\":\"assistant\"")) next
      i = index($0, "\"usage\":{")
      if (!i) next
      u = substr($0, i + 9)
      j = index(u, "[")
      if (j) u = substr(u, 1, j - 1)
      a = num(u, "input_tokens")
      if (a < 0) next
      b = num(u, "cache_creation_input_tokens"); c = num(u, "cache_read_input_tokens")
      t = a + (b > 0 ? b : 0) + (c > 0 ? c : 0)
      if (t == 0) next
      if (!n++) base = t
      if (t > peak) peak = t
    }
    END {
      if (!n) { print "unknown"; exit }
      printf "baseline %d\npeak %d\ngrowth %d\n", base, peak, peak - base
    }'
}

# branch_budget: "<budget> <size>" for the card of the current branch, or
# nothing when the branch is not a card branch or the card is not found.
branch_budget() {
  local id path size budget
  id=$(g symbolic-ref -q --short HEAD | id_of_branch)
  [ -n "$id" ] || return 0
  path=$(wt_cards | ID="$id" awk -F '\t' '$1 == ENVIRON["ID"] { print $2; exit }')
  [ -n "$path" ] || return 0
  size=$(fm_get "$path" size)
  budget=$(conf_get "budget.$size") || return 0
  printf '%s %s\n' "$budget" "$size"
}

cmd_tokens() {
  local budget
  [ -n "${1:-${WORKDECK_TRANSCRIPT-}}" ] ||
    printf 'card: no transcript: WORKDECK_TRANSCRIPT is not set and no path was given\n' >&2
  measure "${1:-${WORKDECK_TRANSCRIPT-}}"
  budget=$(branch_budget)
  [ -z "$budget" ] || printf 'budget %s\n' "$budget"
}

# --- plan ---

# outline_files: the paths of the outlines in the working tree and on the
# base refs, each once. Needs BASE_REFS.
outline_files() {
  local f ref
  {
    for f in "$CARDS_DIR"/plan/*.md; do
      [ -f "$f" ] && printf '%s\n' "$f"
    done
    for ref in $BASE_REFS; do
      g ls-tree --name-only "$ref" "$CARDS_DIR/plan/" 2>/dev/null | grep '\.md$'
    done
  } | sort -u
}

# Reads one outline on stdin, with -v name=<path>, after DIR_OK_AWK and
# LINT_LIB. Prints tab-separated lines, the first field a tag:
#   R <path> <id> <size> <title> <depends>   one per row, after its I lines
#   I <path> <id> <spec|does|not> <text>
#   N <path> <heading>                       an item under Not planned
#   O <path> <spec> <spec_blob> <prefix> <level>   one per outline, last
# and one "card: <path>: <finding>" line per format fault. A front matter
# value that fails its check is printed empty, so a reader never holds an
# unchecked spec path or prefix. A row id is printed as written, up to 40
# characters: check it with valid_id before it reaches a file name, a branch
# name or a pattern. A size is printed only when it is shaped like one, and
# as "?" otherwise; its length is not limited, so a reader that prints sizes
# in a table cuts them as META_AWK does.
# Control characters are removed, as META_AWK does for cards.
OUTLINE_AWK='
function clean(s) { gsub(/[\001-\037\177]/, "", s); return s }
function end_row() {
  if (row == "") return
  if (!count["size"]) err("row " row " has no size")
  if (!count["does"]) err("row " row " has no does")
  if (size != "" && size !~ /^[A-Z][A-Z0-9]*$/) size = "?"
  print "R\t" file "\t" row "\t" size "\t" title "\t" depends
  row = ""
}
closed && /^## / {
  end_row(); split("", count); size = ""; depends = ""; inside = "N"
  if (cur == "Not planned") next
  inside = "R"; i = index(cur, " ")
  row = clean(i ? substr(cur, 1, i - 1) : cur); t = (i ? trim(substr(cur, i + 1)) : "")
  if (row == "") { err("line " FNR ": a row heading is \"## <id> <title>\""); next }
  if (length(row) > 40) { err("line " FNR ": a row id is longer than 40 characters"); row = ""; next }
  if (t == "") err("row " row " has no title")
  if (length(t) > 80) err("title of row " row " is longer than 80 characters")
  if (has_control(t)) err("title of row " row " has a control character")
  title = substr(clean(t), 1, 80)
  next
}
closed && /^- / {
  s = trim(substr($0, 3))
  if (inside == "N") { if (s != "") print "N\t" file "\t" clean(s); next }
  if (row == "") { if (inside == "") err("line " FNR ": an item before the first row heading"); next }
  i = index(s, ":"); k = substr(s, 1, i - 1); v = clean(trim(substr(s, i + 1)))
  if (k !~ /^[a-z]+$/) { err("line " FNR ": an item of a row is \"- <key>: <text>\""); next }
  if (index(" size depends spec does not ", " " k " ") == 0) { err("line " FNR ": unknown row key " k); next }
  if (v == "") { err("line " FNR ": " k " has no text"); next }
  count[k]++
  if (k == "size" || k == "depends") {
    if (count[k] == 2) err("line " FNR ": " k " appears twice in row " row)
    if (count[k] == 1) { if (k == "size") size = v; else depends = v }
  } else print "I\t" file "\t" row "\t" k "\t" v
}
function finish(   n, d) {
  if (file == "") return
  end_row()
  if (!shape_ok()) return
  require("spec spec_blob prefix level")
  if (("spec" in fm) && !dir_ok(fm["spec"])) {
    err("spec must be a relative path inside the repository, of letters, digits and . _ - / only (no .. and no space)"); fm["spec"] = ""
  }
  if (("spec_blob" in fm) && (fm["spec_blob"] !~ /^[0-9a-f]+$/ || (length(fm["spec_blob"]) != 40 && length(fm["spec_blob"]) != 64))) {
    err("spec_blob is not what git hash-object prints"); fm["spec_blob"] = ""
  }
  if ("prefix" in fm) {
    n = split(file, d, "/")
    if (fm["prefix"] !~ /^[A-Z][A-Z0-9]*$/) { err("prefix is not valid (expected something like AUTH)"); fm["prefix"] = "" }
    else if (d[n] != tolower(fm["prefix"]) ".md") err("file name is not the prefix in lowercase (expected " tolower(fm["prefix"]) ".md)")
  }
  if (("level" in fm) && fm["level"] !~ /^[1-6]$/) { err("level must be a digit from 1 to 6"); fm["level"] = "" }
  print "O\t" file "\t" fm["spec"] "\t" fm["spec_blob"] "\t" fm["prefix"] "\t" fm["level"]
}
END {
  if (NR == 0) { file = name; err("is empty") } else finish()
  exit bad
}'

# outlines: every outline as the lines of OUTLINE_AWK. For each file the
# working tree's copy is read if there is one, otherwise the base branch's;
# rows are not merged from the two. Needs BASE_REFS.
outlines() {
  local f
  outline_files | while IFS= read -r f; do
    # The path goes into tab-separated lines and an awk -v value.
    case $f in
      *[!A-Za-z0-9._/-]*)
        printf 'card: %s: file name is not a prefix in lowercase\n' "$(printf '%s' "$f" | tr -c 'A-Za-z0-9._/-' '?')"
        continue
        ;;
    esac
    if [ -f "$f" ]; then cat "$f"; else base_show "$f"; fi |
      awk -v name="$f" -v allowed=" spec spec_blob prefix level " "$DIR_OK_AWK$LINT_LIB$OUTLINE_AWK"
  done
}

# Reads a specification on stdin, with -v name=<outline path> -v level=<1-6>.
# Prints "H <outline path> <heading>", tab-separated, for each # heading at
# that level outside a code fence. A fence is three or more backticks or
# tildes at the start of a line. It ends at a line of the same mark, at least
# as many of them, and nothing else. As in Markdown, up to three spaces may
# come before a heading or a fence; a byte-order mark on line 1 is skipped.
HEADINGS_AWK='
function marks(c) { return match($0, c == "~" ? "^~+" : "^`+") ? RLENGTH : 0 }
NR == 1 { sub(/^\357\273\277/, "") }
# mawk does not strip with sub(/^ ? ? ?/, "").
{ sub(/\r$/, ""); if (match($0, /^ +/) && RLENGTH <= 3) $0 = substr($0, RLENGTH + 1) }
fence != "" { if (marks(fence) >= flen && substr($0, RLENGTH + 1) ~ /^[ \t]*$/) fence = ""; next }
/^(```|~~~)/ { fence = substr($0, 1, 1); flen = marks(fence); next }
match($0, /^#+/) && RLENGTH == level && substr($0, RLENGTH + 1) ~ /^[ \t]+[^ \t]/ {
  h = substr($0, RLENGTH + 1); gsub(/[\001-\037\177]/, "", h); sub(/^ +/, "", h)
  print "H\t" name "\t" h
}'

# plan_facts: reads the lines of outlines and prints what the checks after
# Sizes need from the repository, tab-separated:
#   C <path> <size> <title> <depends> <done>   a card in the working tree
#   K <id>                                     a card, in the working tree or on a base branch
#   D <id>                                     a card that is done on a base branch
#   S <outline path> <state> <spec>            ok, changed, missing, irregular, unreadable or untracked
#   H <outline path> <heading>                 see HEADINGS_AWK
# The specification is read from the working tree, as it is, and only for an
# outline that is in the working tree: one that is only on a base branch was
# checked where it merged, and the tree may be older than it. Needs BASE_REFS.
plan_facts() {
  local f spec blob level state p h
  set --
  while IFS= read -r p; do
    # awk stops at a file it cannot read, and a control character in a path
    # would break the lines of wt_meta. Such a card is still a card (K).
    case $p in '' | *[[:cntrl:]]*) continue ;; esac
    [ -r "$p" ] && set -- "$@" "$p"
  done <<INDEX
$(wt_cards | cut -f2-)
INDEX
  wt_meta "$@" | sed "s/^/C$TAB/"
  { wt_cards; base_cards; } | cut -f1 | sed "s/^/K$TAB/"
  base_done | to_index | cut -f1 | sed "s/^/D$TAB/"
  # An empty field would be lost to read; - stands for one. The outline
  # reader let no space into any of these.
  awk -F '\t' '$1 == "O" && $3 != "" { print $2, $3, ($4 == "" ? "-" : $4), ($6 == "" ? "-" : $6) }' |
    while read -r f spec blob level; do
      [ -f "$f" ] || continue
      # A link is not followed: it could point outside the repository.
      if [ -L "$spec" ] || { [ -e "$spec" ] && [ ! -f "$spec" ]; }; then state=irregular
      elif [ ! -e "$spec" ]; then state=missing
      elif [ ! -r "$spec" ]; then state=unreadable
      elif ! g ls-files --error-unmatch -- "$spec" > /dev/null 2>&1; then state=untracked
      elif ! h=$(g hash-object -- "$spec" 2>/dev/null); then state=unreadable
      elif [ "$blob" != - ] && [ "$h" != "$blob" ]; then state=changed
      else state=ok
      fi
      printf 'S\t%s\t%s\t%s\n' "$f" "$state" "$spec"
      case $state in ok | changed) [ "$level" = - ] || awk -v name="$f" -v level="$level" "$HEADINGS_AWK" < "$spec" ;; esac
    done
}

# Reads the lines of outlines, then those of plan_facts. Prints the format
# findings as they are, then the findings of the checks Ids, Sizes,
# Dependencies, Specification and Coverage, in that order.
PLAN_AWK='
function err(f, s) { print "card: " f ": " s; bad = 1 }
# As the tests gate compares names, but a byte above 127 is kept, so that a
# heading in another script is still a heading. Of those bytes only the
# UTF-8 general punctuation (dashes, curly quotes) and the Latin-1 signs are
# removed; case is folded for ASCII alone. A heading with no letter or digit
# at all is compared as written, less its spaces.
function norm(s,   t) {
  t = tolower(s); gsub(/\342\200[\200-\277]|\302[\240-\277]/, "", t)
  gsub(/[\001-\057\072-\100\133-\140\173-\177]/, "", t)
  if (t == "") { t = s; gsub(/[ \t]/, "", t) }
  return t
}
# The C1 control characters, as UTF-8, go the way of the others.
function show(s) { gsub(/\302[\200-\237]/, "", s); return "\"" substr(s, 1, 80) "\"" }
function covered(f) { return (state[f] == "ok" || state[f] == "changed") && level[f] != "" }
/^card: / { print; bad = 1; s = substr($0, 7); faulty[substr(s, 1, index(s, ": ") - 1)] = 1; next }
$1 == "R" { n++; rfile[n] = $2; rid[n] = $3; rsize[n] = $4; rdep[n] = $6; isrow[$3] = 1 }
$1 == "I" && $4 == "spec" { c++; cfile[c] = $2; cid[c] = $3; ctext[c] = $5; cited[$2, norm($5)] = 1 }
$1 == "N" { np++; nfile[np] = $2; ntext[np] = $3; cited[$2, norm($3)] = 1 }
$1 == "O" { m++; ofile[m] = $2; spec[$2] = $3; prefix[$2] = $5; level[$2] = $6 }
$1 == "C" {
  k = split($2, d, "/")
  if (match(d[k], /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?/)) {
    id = substr(d[k], 1, RLENGTH); known[id] = 1; x = $5; gsub(/,/, " ", x); deps[id] = deps[id] " " x
  }
}
$1 == "K" { known[$2] = 1 }
$1 == "D" { isdone[$2] = 1 }
$1 == "S" { state[$2] = $3 }
$1 == "H" { q++; hfile[q] = $2; htext[q] = $3; has[$2, norm($3)] = 1 }
END {
  for (i = 1; i <= n; i++) {
    f = rfile[i]; id = rid[i]
    if (id !~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/) err(f, "row id " id " is not valid (expected something like AUTH-03)")
    else {
      if (id ~ /[a-z]$/) err(f, "row id " id " carries a letter, which is for a split remainder and is not written in an outline")
      if (prefix[f] != "" && substr(id, 1, index(id, "-") - 1) != prefix[f]) err(f, "row id " id " does not start with the prefix " prefix[f])
    }
    # Reported once for an id, where its second row is.
    if (!(id in seen)) seen[id] = f
    else if (seen[id] != "") {
      err(f, "id " id " is in two rows" (seen[id] == f ? "" : " (the other is in " seen[id] ")"))
      seen[id] = ""
    }
  }
  for (i = 1; i <= m; i++) {
    f = ofile[i]; p = prefix[f]
    if (p == "") continue
    if (p in owner) err(f, "prefix " p " is also the prefix of " owner[p]); else owner[p] = f
    if (p == "Q") err(f, "prefix Q is the prefix of the quick lane")
  }
  for (i = 1; i <= n; i++)
    if (rsize[i] == "?") err(rfile[i], "row " rid[i] ": size is not a size (capitals and digits, like S)")
    else if (rsize[i] != "" && index(sizes, " " rsize[i] " ") == 0) err(rfile[i], "row " rid[i] ": size " rsize[i] " has no budget in workdeck.conf")
  for (i = 1; i <= n; i++) {
    f = rfile[i]; id = rid[i]; k = split(rdep[i], d, ",")
    # Of an id that is in two rows, the first row is the node.
    own = !(id in node)
    if (own) { node[id] = i; if (!(id in deps)) deps[id] = "" }
    for (j = 1; j <= k; j++) {
      x = d[j]; gsub(/^[ \t]+|[ \t]+$/, "", x)
      if (x !~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/ || length(x) > 40) err(f, "row " id ": depends has an invalid id")
      else if (!(x in isrow) && !(x in known)) err(f, "row " id ": depends on " x ", which is neither a row nor a card")
      else if (own) deps[id] = deps[id] " " x
    }
  }
  # As in lint_cards, over rows and cards together: remove what depends only
  # on what is removed; what stays is a cycle or depends on one.
  do {
    changed = 0
    for (id in deps) {
      if (id in gone) continue
      free = 1; k = split(deps[id], d, " ")
      for (j = 1; j <= k; j++) if ((d[j] in deps) && !(d[j] in gone)) free = 0
      if (free) { gone[id] = 1; changed = 1 }
    }
  } while (changed)
  for (i = 1; i <= n; i++) if (node[rid[i]] == i && !(rid[i] in gone)) err(rfile[i], "row " rid[i] " is in, or depends on, a dependency cycle")
  for (i = 1; i <= m; i++) {
    f = ofile[i]
    if (state[f] == "missing") err(f, "the specification " spec[f] " is missing")
    else if (state[f] == "irregular") err(f, "the specification " spec[f] " is not a regular file")
    else if (state[f] == "unreadable") err(f, "the specification " spec[f] " cannot be read")
    else if (state[f] == "untracked") err(f, "the specification " spec[f] " is not tracked by git")
  }
  # An outline with a format finding may have lost a row or an item, so a
  # heading is not reported as one that no row of it cites.
  for (i = 1; i <= q; i++) {
    f = hfile[i]; h = norm(htext[i])
    if (h == "" || (f in faulty) || ((f, h) in cited) || ((f, h) in told)) continue
    told[f, h] = 1
    err(f, "the heading " show(htext[i]) " of " spec[f] " is cited by no row and is not under Not planned")
  }
  for (i = 1; i <= c; i++) {
    f = cfile[i]
    if (covered(f) && !(cid[i] in isdone) && !((f, norm(ctext[i])) in has))
      err(f, "row " cid[i] " cites the heading " show(ctext[i]) ", which " spec[f] " does not have at level " level[f])
  }
  for (i = 1; i <= np; i++) {
    f = nfile[i]
    if (covered(f) && !((f, norm(ntext[i])) in has))
      err(f, "Not planned lists the heading " show(ntext[i]) ", which " spec[f] " does not have at level " level[f])
  }
  exit bad
}'

# plan_refs: sets BASE_REFS for the plan commands. Like lint, they run where
# there is no base branch: a first commit not yet made, or a CI checkout of
# one commit. Then only the working tree is read.
plan_refs() {
  if g rev-parse -q --verify "refs/remotes/origin/$BASE" > /dev/null 2>&1 ||
    g rev-parse -q --verify "refs/heads/$BASE" > /dev/null 2>&1; then
    base_ref
  else
    BASE_REFS=""
  fi
}

# spec_ok <path>: a specification path, held to the rule of the outline
# reader. Nothing but its characters is looked at.
spec_ok() {
  case $1 in '' | *[!A-Za-z0-9._/-]*) return 1 ;; esac
  printf '%s\n' "$1" | awk "$DIR_OK_AWK"'{ exit !dir_ok($0) }'
}

# need_prefix <prefix>: before it reaches a file name or a pattern. A row id
# is the prefix, a hyphen and digits, and the outline reader stops at 40
# characters.
need_prefix() {
  [[ $1 =~ ^[A-Z][A-Z0-9]*$ ]] || usage_die plan "not a prefix (expected something like AUTH)"
  [ "${#1}" -le 30 ] || usage_die plan "the prefix is longer than 30 characters"
  # A link is not followed: it could point outside the repository.
  [ ! -L "$CARDS_DIR/plan" ] || die 1 "$CARDS_DIR/plan is a symbolic link"
}

# outline_path <prefix>: the file of the outline with that prefix.
outline_path() { printf '%s/plan/%s.md\n' "$CARDS_DIR" "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; }

# cmd_plan_new <spec path> <PREFIX> [--level N]: an outline with its front
# matter and no rows. A refusal is exit 1; the path is printed only once it
# has passed spec_ok.
cmd_plan_new() {
  local spec="" prefix="" have=0 level=2 path hit n levels=""
  while [ "$#" -gt 0 ]; do
    case $1 in
      --level)
        [ "$#" -ge 2 ] || usage_die plan "$1 needs a value"
        level=$2
        shift 2
        ;;
      --*) usage_die plan "unknown option $1" ;;
      *)
        case $have in
          0) spec=$1 ;;
          1) prefix=$1 ;;
          *) usage_die plan ;;
        esac
        have=$((have + 1))
        shift
        ;;
    esac
  done
  if [ "$have" -ne 2 ] || [ -z "$spec" ]; then usage_die plan; fi
  need_prefix "$prefix"
  [[ $level =~ ^[1-6]$ ]] || usage_die plan "--level takes a digit from 1 to 6"

  case $spec in
    *" "*) die 1 "the specification path has a space in it, and a Read entry ends at its first space" ;;
  esac
  spec_ok "$spec" ||
    die 1 "the specification must be a relative path inside the repository, from its root, of letters, digits and . _ - / only (no .. and no ./)"
  [ "$prefix" != Q ] || die 1 "prefix Q is the prefix of the quick lane"
  plan_refs
  hit=$(outlines | P="$prefix" awk -F '\t' '$1 == "O" && $5 == ENVIRON["P"] { print $2; exit }')
  [ -z "$hit" ] || die 1 "prefix $prefix is the prefix of $hit"
  hit=$({ wt_cards; base_cards; } | cut -f1 | P="$prefix-" awk 'index($0, ENVIRON["P"]) == 1 { print; exit }')
  [ -z "$hit" ] || die 1 "card $hit has the prefix $prefix"
  path=$(outline_path "$prefix")
  if [ -e "$path" ] || [ -L "$path" ]; then die 1 "$path already exists"; fi

  # The states of plan_facts, in its order.
  if [ -L "$spec" ] || { [ -e "$spec" ] && [ ! -f "$spec" ]; }; then die 1 "the specification $spec is not a regular file"
  elif [ ! -e "$spec" ]; then die 1 "the specification $spec is missing"
  elif [ ! -r "$spec" ]; then die 1 "the specification $spec cannot be read"
  elif ! g ls-files --error-unmatch -- "$spec" > /dev/null 2>&1; then die 1 "the specification $spec is not tracked by git"
  fi
  hit=$(g hash-object -- "$spec" 2>/dev/null) || die 1 "the specification $spec cannot be read"
  for n in 1 2 3 4 5 6; do
    [ -z "$(awk -v name=- -v level="$n" "$HEADINGS_AWK" < "$spec")" ] || levels="$levels${levels:+, }$n"
  done
  case ", $levels," in
    *", $level,"*) ;;
    *) die 1 "$spec has no heading at level $level; ${levels:+levels with headings: }${levels:-it has no headings}" ;;
  esac

  mkdir -p "$CARDS_DIR/plan" || die 2 "cannot create $CARDS_DIR/plan"
  printf -- '---\nspec: %s\nspec_blob: %s\nprefix: %s\nlevel: %s\n---\n' "$spec" "$hit" "$prefix" "$level" > "$path" ||
    die 2 "cannot write $path"
  printf '%s\n' "$path"
}

# cmd_plan_accept <PREFIX>: sets spec_blob, in the working tree's outline, to
# the hash of the specification as it is now. No other line changes.
cmd_plan_accept() {
  local path spec h tmp rc
  [ "$#" -eq 1 ] || usage_die plan
  need_prefix "$1"
  path=$(outline_path "$1")
  if [ -L "$path" ] || [ ! -f "$path" ]; then die 1 "no outline for the prefix $1 ($path is not a file)"; fi
  spec=$(fm_get "$path" spec)
  spec_ok "$spec" || die 1 "$path: spec is not a relative path inside the repository; run card plan"
  # Only a tracked file is hashed, as in plan new: the value is committed.
  if [ -L "$spec" ] || [ ! -f "$spec" ] || ! g ls-files --error-unmatch -- "$spec" > /dev/null 2>&1 ||
    ! h=$(g hash-object -- "$spec" 2>/dev/null); then
    die 1 "$path: the specification $spec is not a tracked file that can be read; run card plan"
  fi
  # awk may cut a line at a NUL byte.
  [ "$(tr -d '\000' < "$path" | wc -c)" -eq "$(wc -c < "$path")" ] || die 1 "$path: has a NUL byte"
  tmp=$(mktemp) || die 2 "cannot create a temporary file"
  # Written back with cat so the file keeps its mode. A last line with no
  # newline stays without one.
  H="$h" awk -v nl="$(tail -c 1 "$path" | wc -l | tr -d ' ')" '
    function put(s) { printf "%s%s", sep, s; sep = "\n" }
    NR == 1 && /^---\r?$/ { infm = 1; put($0); next }
    infm && /^---\r?$/ { infm = 0 }
    infm && !set && /^spec_blob:/ { put("spec_blob: " ENVIRON["H"] (/\r$/ ? "\r" : "")); set = 1; next }
    { put($0) }
    END { if (nl + 0) printf "\n"; exit !set }' "$path" > "$tmp"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$tmp"
    die 1 "$path: front matter has no spec_blob line; run card plan"
  fi
  cat "$tmp" > "$path"
  rc=$?
  rm -f "$tmp"
  [ "$rc" -eq 0 ] || die 2 "$path: cannot write"
}

# cmd_plan_start <id>: the card file for a row (section 7 of the design):
# what card new writes, with the specification under Read, the does lines
# under Acceptance and the not lines under Out of scope. The row is the one
# deck_table lists: the first of that id, in the order of the outline paths.
# The row's text is written as it is in the outline and is never evaluated.
# An outline with a finding of the reader is refused: the reader cuts a long
# title and takes the first of two sizes, and the card would not be the row.
cmd_plan_start() {
  local existing out row file title size depends fault path body
  [ "$#" -eq 1 ] || usage_die plan
  need_id "$1"
  plan_refs
  existing=$({ wt_cards; base_cards; } | ID="$1" awk -F '\t' '$1 == ENVIRON["ID"] { print $2; exit }')
  [ -z "$existing" ] || die 1 "$existing: card $1 already exists"
  out=$(outlines)
  # Five lines: the outline, the size, the title, the dependencies and the
  # specification. Then the items, "<key><TAB><text>".
  row=$(printf '%s\n' "$out" | ID="$1" awk -F '\t' '
    $1 == "I" { if ($3 == ENVIRON["ID"]) buf = buf $4 "\t" $5 "\n"; next }
    $1 == "R" { if (file == "" && $3 == ENVIRON["ID"]) { file = $2; head = $4 "\n" $5 "\n" $6; items = buf } buf = ""; next }
    $1 == "O" && $2 == file { spec = $3 }
    END { if (file != "") printf "%s\n%s\n%s\n%s", file, head, spec, items }')
  if [ -z "$row" ]; then
    case "
$out" in
      *"
card: "*) die 1 "no row $1 in $CARDS_DIR/plan, and an outline there has a fault; run card plan" ;;
    esac
    die 1 "no row $1 in $CARDS_DIR/plan"
  fi
  file=$(printf '%s\n' "$row" | sed -n 1p)
  size=$(printf '%s\n' "$row" | sed -n 2p)
  title=$(printf '%s\n' "$row" | sed -n 3p)
  depends=$(printf '%s\n' "$row" | sed -n 4p)
  case "
$out" in
    *"
card: $file: "*) die 1 "$file: the outline has a fault; run card plan" ;;
  esac
  spec_ok "$(printf '%s\n' "$row" | sed -n 5p)" ||
    die 1 "$file: spec is not a relative path inside the repository; run card plan"
  # A fault in the row is a refusal that names the outline, not the usage
  # error write_card would make of it. card plan does not look at the start
  # of a title, so that message does not name it.
  fault=$(title_fault "$title")
  [ -z "$fault" ] || die 1 "$file: row $1: $fault; change the title in the outline"
  sizes | grep -qxF -- "$size" || die 1 "$file: row $1 has no size that has a budget; run card plan"
  depends_list "$depends" > /dev/null || die 1 "$file: row $1: depends is not a list of card ids; run card plan"
  path=$(write_card "$1" "$title" "$size" "$depends") || exit $?
  # The row goes in on stdin: a long one does not fit in the environment.
  # A card that was not filled in is removed, or the next run would find it.
  if ! body=$(printf '%s\n' "$row" | ID="$1" awk '
    NR == FNR {
      if (FNR == 5) spec = $0
      if (FNR < 6) next
      t = index($0, "\t"); k = substr($0, 1, t - 1); v = substr($0, t + 1)
      if (k == "spec") heads = heads (heads == "" ? ": " : "; ") v
      else if (k == "does") does = does "- " v "\n"
      else if (k == "not") nots = nots "- " v "\n"
      next
    }
    { print }
    $0 == "## Read" { print "- " spec " (row " ENVIRON["ID"] heads ")" }
    $0 == "## Acceptance" { printf "%s", does }
    $0 == "## Out of scope" { printf "%s", nots }' - "$path") || ! printf '%s\n' "$body" > "$path"; then
    rm -f "$path"
    die 2 "$path: cannot write"
  fi
  printf '%s\n' "$path"
}

# cmd_plan_check <id>: the three rules of section 7 of the design, for one
# card against the working tree. Every failure is a line on stderr. It is
# true when it runs and not after the work starts, so no gate calls it.
cmd_plan_check() {
  local path files e p note f lit hit rc=0
  [ "$#" -eq 1 ] || usage_die plan
  need_id "$1"
  path=$(card_path "$1") || exit $?
  [ -r "$path" ] || die 2 "$path: cannot be read"

  while IFS= read -r e; do
    [ -n "$e" ] || continue
    p=${e%% *}
    p=${p%%#*}
    # A card arrives in someone else's pull request, and a session reads
    # what Read names: a path that leaves the repository is refused, as the
    # spec of an outline is.
    case /$p/ in
      //?* | */../*) printf 'card: %s: Read: %s is not a path inside the repository\n' "$path" "$p" >&2 ;;
      *)
        [ -z "$p" ] || [ ! -e "$p" ] || continue
        printf 'card: %s: Read: %s does not exist\n' "$path" "${p:-$e}" >&2
        ;;
    esac
    rc=1
  done <<READ
$(section_items "$path" Read)
READ

  # The files the scope gate sees: an ignored file is not one of them.
  files=$(g ls-files && g ls-files --others --exclude-standard) || die 2 "cannot list the files of the repository"
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    note=""
    case $e in *' '*) note=${e#* } ;; esac
    note=${note#"${note%%[! ]*}"}
    e=${e%% *}
    p=$(printf '%s\n' "$e" | touch_patterns)
    hit=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      # shellcheck disable=SC2254
      case $f in $p)
        hit=1
        break
        ;;
      esac
    done <<FILES
$files
FILES
    case $note in
      '(new)'*)
        # A full path is a pattern that matches one name: no pattern
        # character outside an escape, such as app/\[id\]/page.tsx, and no
        # segment the scope gate would never print. It is tested on disk,
        # so that an ignored file is seen too.
        lit=$(printf '%s\n' "$p" | sed 's/\\\(.\)/\1/g')
        case /$(printf '%s\n' "$p" | sed 's/\\.//g')/ in
          // | *[\*\?\[\\]* | *//* | */./* | */../*)
            printf 'card: %s: Touch: %s is marked (new) and is not a full path\n' "$path" "$e" >&2
            ;;
          *)
            if [ -e "$lit" ] || [ -L "$lit" ]; then
              printf 'card: %s: Touch: %s is marked (new) and exists\n' "$path" "$e" >&2
            elif [ "$hit" -eq 1 ]; then
              printf 'card: %s: Touch: %s is marked (new) and is a tracked file\n' "$path" "$e" >&2
            else
              # The scope gate cannot see a change to a file git ignores,
              # and a path git cannot answer for is not one it will list.
              g check-ignore -q -- "$lit" 2> /dev/null
              case $? in
                1) continue ;;
                0) printf 'card: %s: Touch: %s is marked (new) and git ignores it\n' "$path" "$e" >&2 ;;
                *) printf 'card: %s: Touch: %s is marked (new) and git cannot track it\n' "$path" "$e" >&2 ;;
              esac
            fi
            ;;
        esac
        ;;
      *)
        [ "$hit" -eq 0 ] || continue
        printf 'card: %s: Touch: %s matches no file\n' "$path" "$e" >&2
        ;;
    esac
    rc=1
  done <<TOUCH
$(section_items "$path" Touch)
TOUCH

  if [ -z "$(section_items "$path" 'Out of scope')" ]; then
    printf 'card: %s: Out of scope has no item\n' "$path" >&2
    rc=1
  fi
  return "$rc"
}

# plan_branch_check: on a plan/* branch, a finding for each file that differs
# from the fork point and is not an outline: <cards_dir>/plan/<name>.md, as
# outline_files reads them, so not a name that starts with a dot and nothing
# in a directory below. A plan run writes no card and no code. With no base
# branch the check cannot run, and base_ref exits 2.
plan_branch_check() {
  local branch fp
  branch=$(g symbolic-ref -q --short HEAD) || return 0
  case $branch in plan/*) ;; *) return 0 ;; esac
  base_ref
  fp=$(fork_point) || exit $?
  diff_files "$fp" | P="$CARDS_DIR/plan/" awk '
    BEGIN { p = ENVIRON["P"] }
    { name = index($0, p) == 1 ? substr($0, length(p) + 1) : "" }
    name !~ /^[^.\/][^\/]*\.md$/ {
      print "card: " $0 ": on a plan branch only an outline, " p "<name>.md, may differ from the base branch"
      bad = 1
    }
    END { exit bad }' >&2
}

# cmd_plan: the checks of every outline, in the order of the table in
# section 11.1 of the design. Findings go to stderr. A specification that
# differs from spec_blob is one line on stdout and not a finding.
cmd_plan() {
  local out facts rc=0 sub
  case ${1--} in
    -) [ "$#" -eq 0 ] || usage_die plan ;;
    new | accept | start | check)
      sub=$1
      shift
      "cmd_plan_$sub" "$@"
      return
      ;;
    *) usage_die plan ;;
  esac
  plan_refs
  out=$(outlines)
  if [ -z "$out" ]; then
    printf 'no outline in %s/plan\n' "$CARDS_DIR"
  else
    facts=$(printf '%s\n' "$out" | plan_facts)
    printf '%s\n%s\n' "$out" "$facts" | awk -F '\t' -v sizes=" $(sizes | tr '\n' ' ')" "$PLAN_AWK" >&2
    rc=$?
    printf '%s\n' "$facts" | awk -F '\t' '$1 == "S" && $3 == "changed" { print $2 ": the specification " $4 " differs from spec_blob" }'
  fi
  plan_branch_check || rc=1
  return "$rc"
}

# --- main ---

main() {
  local n=$# arg cmd want
  FETCH=0
  while [ "$n" -gt 0 ]; do
    arg=$1
    shift
    n=$((n - 1))
    if [ "$arg" = --fetch ]; then FETCH=1; else set -- "$@" "$arg"; fi
  done

  [ "$#" -gt 0 ] || { usage >&2; exit 2; }
  cmd=$1
  shift
  case $cmd in
    help | -h | --help)
      usage
      exit 0
      ;;
    version | -V | --version)
      printf 'card %s\n' "$VERSION"
      exit 0
      ;;
    next | show | list | status | new | done | lint | touched | tests | tokens | log-new | stats | plan | conf) ;;
    *) die 2 "unknown command '$cmd'; run 'card help'" ;;
  esac
  for arg in "$@"; do
    case $arg in
      -h | --help)
        printf 'usage: %s\n' "$(synopsis "$cmd")"
        exit 0
        ;;
    esac
  done

  # How many arguments each command takes; new and plan parse their own.
  case $cmd in
    next | list | status | lint | stats) want=0 ;;
    show | done | touched | tests | conf) want=1 ;;
    log-new) want=2 ;;
    tokens) [ "$#" -le 1 ] || usage_die "$cmd"; want=$# ;;
    new | plan) want=$# ;;
  esac
  [ "$#" -eq "$want" ] || usage_die "$cmd"

  enter_repo
  load_conf
  case $cmd in
    conf) cmd_conf "$@" ;;
    show) cmd_show "$@" ;;
    lint) cmd_lint ;;
    list) cmd_list ;;
    next) cmd_next ;;
    status) cmd_status ;;
    new) cmd_new "$@" ;;
    done) cmd_done "$@" ;;
    touched) cmd_touched "$@" ;;
    tests) cmd_tests "$@" ;;
    log-new) cmd_log_new "$@" ;;
    stats) cmd_stats ;;
    plan) cmd_plan "$@" ;;
    tokens) cmd_tokens "$@" ;;
  esac
}

main "$@"
