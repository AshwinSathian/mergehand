#!/usr/bin/env bash
# shellcheck disable=SC2034  # ponytail: globals land before their readers while the file is built; drop when stage 4 is done
# card: the Workdeck command-line tool.
#
# One file, so people and CI can fetch it without the plugin. It must run on
# bash 3.2 (macOS /bin/bash) with BSD or GNU awk, sed, grep and sort, plus git.
# workdeck.conf and card files are parsed as text and are never sourced or
# evaluated.
set -u
# ponytail: bytewise ranges and sort order everywhere; the cost is that length
# limits count bytes, not characters. Revisit if non-ASCII titles matter.
LC_ALL=C
export LC_ALL

TAB=$(printf '\t')


usage() {
  cat <<'USAGE'
usage: card <command> [arguments] [--fetch]

  next                      print the first ready card
  show <id>                 print one card
  list                      one line per card: state, id, size, title
  status                    current card, open work, next ready card
  new <id> <title> [--size S] [--depends ids]
                            create a card file
  done <id>                 set done: true in the card file
  lint                      check every card and log file
  touched <id>              compare changed files with the card's Touch list
  tests <id>                check that each Tests line names a test that exists
  tokens [transcript]       baseline, peak and growth for a session transcript
  log-new <id> <outcome>    create a session log entry
  stats                     growth per card size across session logs
  conf <key>                print one configuration value

--fetch runs git fetch --prune and reads open pull requests with gh first.
Exit codes: 0 ok, 1 a check failed, 2 usage or configuration error.
USAGE
}

die() {
  local code=$1
  shift
  printf 'card: %s\n' "$*" >&2
  exit "$code"
}

# Every git call goes through here so user configuration cannot change the
# shape of the output.
g() { git -c core.quotepath=off -c color.ui=false "$@"; }

enter_repo() {
  local root
  root=$(g rev-parse --show-toplevel 2>/dev/null) || die 2 "not a git repository"
  cd "$root" || die 2 "cannot enter $root"
  [ -f workdeck.conf ] || die 2 "no workdeck.conf in $root; run /workdeck:init"
}

# --- configuration ---

CONF_KEYS='version|check|base|cards_dir|log_dir|touch_ignore|status_max_chars|reviewer|budget\.[A-Z][A-Z0-9]*'
CONF='version=1
base=main
cards_dir=cards
log_dir=log
budget.XS=35000
budget.S=70000
budget.M=100000
touch_ignore=
status_max_chars=6000
reviewer=on'

# conf_get <key>: prints the value; fails when the key has none.
conf_get() {
  printf '%s\n' "$CONF" | K="$1" awk '
    BEGIN { k = ENVIRON["K"] "=" }
    index($0, k) == 1 { v = substr($0, length(k) + 1); found = 1 }
    END { if (!found) exit 1; print v }'
}

conf_die() { die 2 "workdeck.conf: $*"; }

is_number() {
  case $1 in '' | *[!0-9]*) return 1 ;; esac
}

# A directory setting must stay inside the repository and must not look like
# an option: it is handed to git and used to build file names.
check_dir_setting() {
  local key=$1 v
  v=$(conf_get "$key")
  case $v in
    '' | [!A-Za-z0-9._]* | *[!A-Za-z0-9._/-]* | .. | ../* | */.. | */../*)
      conf_die "$key must be a relative path inside the repository, got '$v'"
      ;;
  esac
}

load_conf() {
  local parsed err v size
  parsed=$(awk -v keys="^($CONF_KEYS)\$" '
    { sub(/\r$/, "") }
    /^[ \t]*(#|$)/ { next }
    {
      i = index($0, "=")
      if (i == 0) { printf "!%d: expected key = value\n", NR; next }
      k = substr($0, 1, i - 1); v = substr($0, i + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (k !~ keys) { printf "!%d: unknown key\n", NR; next }
      print k "=" v
    }' workdeck.conf)
  err=$(printf '%s\n' "$parsed" | grep '^!' | head -1)
  [ -z "$err" ] || die 2 "workdeck.conf:${err#!}"
  CONF="$CONF
$parsed"

  v=$(conf_get version)
  [ "$v" = 1 ] || conf_die "unsupported version '$v' (this card understands version 1)"
  check_dir_setting cards_dir
  check_dir_setting log_dir
  v=$(conf_get base)
  case $v in -*) conf_die "base is not a valid branch name: '$v'" ;; esac
  g check-ref-format "refs/heads/$v" 2>/dev/null || conf_die "base is not a valid branch name: '$v'"
  is_number "$(conf_get status_max_chars)" || conf_die "status_max_chars must be a number"
  case $(conf_get reviewer) in on | off) ;; *) conf_die "reviewer must be on or off" ;; esac
  for size in $(sizes); do
    is_number "$(conf_get "budget.$size")" || conf_die "budget.$size must be a number of tokens"
  done

  BASE=$(conf_get base)
  CARDS_DIR=$(conf_get cards_dir)
  LOG_DIR=$(conf_get log_dir)
}

# sizes: the card sizes that have a budget, one per line.
sizes() { printf '%s\n' "$CONF" | sed -n 's/^budget\.\([A-Z][A-Z0-9]*\)=.*/\1/p' | sort -u; }

need_check() { [ -n "$(conf_get check)" ] || conf_die "check is not set"; }

cmd_conf() {
  [ "$#" -eq 1 ] || die 2 "usage: card conf <key>"
  printf '%s\n' "$1" | grep -Eq "^($CONF_KEYS)\$" || die 2 "workdeck.conf has no key '$1'"
  [ "$1" != check ] || need_check
  conf_get "$1" || die 2 "workdeck.conf: no value for '$1'"
}

# --- cards ---

ID_RE='^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$'

valid_id() { [[ $1 =~ $ID_RE ]]; }

# need_id <id>: every id passes here before it reaches a file name, a branch
# name or a pattern.
need_id() {
  if [ "$#" -lt 1 ] || ! valid_id "$1"; then die 2 "not a card id (expected something like AUTH-03)"; fi
}

# to_index: reads file paths, prints "<id><TAB><path>" for those named
# <id>.md or <id>-<slug>.md, in natural id order. The id always comes from
# the file name; lint checks that the front matter agrees.
to_index() {
  awk '{
    n = split($0, part, "/"); name = part[n]
    if (!match(name, /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?/)) next
    id = substr(name, 1, RLENGTH); rest = substr(name, RLENGTH + 1)
    if (rest == ".md" || rest ~ /^-.*\.md$/) print id "\t" $0
  }' | sort -t "$TAB" -k1,1V -k2,2
}

# wt_cards: the card files in the working tree, as an index.
wt_cards() {
  local f
  for f in "$CARDS_DIR"/*.md; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done | to_index
}

# card_path <id>: prints the path of the card. Exit 1 when the id is unknown
# or used by two files.
card_path() {
  local id=$1 index hits
  index=$(wt_cards)
  hits=$(printf '%s\n' "$index" | ID="$id" awk -F '\t' '$1 == ENVIRON["ID"] { print $2 }')
  case $hits in
    '')
      die 1 "no card $id in $CARDS_DIR; cards with prefix ${id%%-*}:$(printf '%s\n' "$index" |
        P="${id%%-*}-" awk -F '\t' 'index($1, ENVIRON["P"]) == 1 { printf " %s", $1 }')"
      ;;
    *"
"*) die 1 "two cards have the id $id: $(printf '%s' "$hits" | tr '\n' ' '); run card lint" ;;
  esac
  printf '%s\n' "$hits"
}

# fm_get <file> <key>: one front matter value. Reads only between the first
# two --- lines.
fm_get() {
  K="$2" awk '
    BEGIN { k = ENVIRON["K"] ":" }
    { sub(/\r$/, "") }
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    index($0, k) == 1 {
      v = substr($0, length(k) + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", v)
      print v
      exit
    }' "$1"
}

cmd_show() {
  local path
  need_id "$@"
  path=$(card_path "$1") || exit $?
  cat "$path"
}

# --- lint ---

# Shared awk helpers for the two lint programs. err() prints one finding;
# the caller sends stdout to stderr and uses the exit status.
# shellcheck disable=SC2016
LINT_LIB='
function err(msg) { print "card: " file ": " msg; bad = 1 }
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function has_control(s,   i, c) {
  for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (c < " " || c == "\177") return 1 }
  return 0
}
# front_matter_line: returns 1 when the line was stored in fm[].
function front_matter_line(   i, k, v, c) {
  if ($0 !~ /^[a-z_]+:( .*)?$/) { err("line " FNR ": front matter must be flat key: value lines"); return 0 }
  i = index($0, ":"); k = substr($0, 1, i - 1); v = trim(substr($0, i + 1))
  if (index(allowed, " " k " ") == 0) { err("line " FNR ": unknown front matter key " k); return 0 }
  if (k in fm) err("line " FNR ": " k " appears twice")
  c = substr(v, 1, 1)
  if (c == "\"" || c == "\047") err("line " FNR ": " k " is quoted; write the value bare")
  if (v == "|" || v == ">" || v ~ /^[|>][+-]$/) err("line " FNR ": " k " starts a multi-line value")
  if (c == "[" || c == "{") err("line " FNR ": " k " is a nested value")
  fm[k] = v
  return 1
}
function require(keys,   i, n, k) {
  n = split(keys, k, " ")
  for (i = 1; i <= n; i++) if (!(k[i] in fm)) err("front matter has no " k[i])
}
function reset() {
  file = FILENAME; opened = 0; closed = 0; crlf = 0; cur = ""; body = 0
  split("", fm); split("", seen); split("", items)
}
{ if (sub(/\r$/, "")) crlf = 1 }
FNR == 1 { finish(); reset(); if ($0 == "---") opened = 1; next }
opened && !closed { if ($0 == "---") closed = 1; else front_matter_line(); next }
closed {
  body++
  if ($0 ~ /^## /) { cur = trim(substr($0, 4)); seen[cur] = 1 }
  else if (cur != "" && $0 ~ /^- *[^ ]/) items[cur]++
}
function shape_ok() {
  if (file == "") return 0
  if (crlf) err("has CRLF line endings; convert to LF")
  if (!opened) { err("does not start with a --- front matter line"); return 0 }
  if (!closed) { err("front matter is not closed with ---"); return 0 }
  return 1
}
'

lint_cards() {
  local known
  known=$(wt_cards | cut -f1 | tr '\n' ' ')
  [ "$#" -gt 0 ] || return 0
  awk -v sizes=" $(sizes | tr '\n' ' ')" -v known=" $known" \
    -v allowed=" id title size depends done " "$LINT_LIB"'
    function finish(   i, n, d, x, s, sec) {
      if (!shape_ok()) return
      n = split(file, d, "/"); match(d[n], /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?/); fid = substr(d[n], 1, RLENGTH)
      if (fid in first) err("id " fid " is also used by " first[fid]); else first[fid] = file
      require("id title size depends done")
      if ("id" in fm) {
        if (fm["id"] !~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/) err("id is not valid (expected something like AUTH-03)")
        else if (fm["id"] != fid) err("id " fm["id"] " does not match the file name")
      }
      if ("title" in fm) {
        if (fm["title"] == "") err("title is empty")
        if (length(fm["title"]) > 80) err("title is longer than 80 characters")
        if (has_control(fm["title"])) err("title has a control character")
      }
      if ("size" in fm && index(sizes, " " fm["size"] " ") == 0) err("size " fm["size"] " has no budget in workdeck.conf")
      if ("done" in fm && fm["done"] != "true" && fm["done"] != "false") err("done must be true or false")
      deps[fid] = ""
      if (fm["depends"] != "") {
        n = split(fm["depends"], d, ",")
        for (i = 1; i <= n; i++) {
          x = trim(d[i])
          if (x !~ /^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$/) err("depends has an invalid id")
          else if (index(known, " " x " ") == 0) err("depends on " x ", which is not a card")
          else deps[fid] = deps[fid] " " x
        }
      }
      n = split("Read Touch Tests Acceptance", sec, " ")
      for (i = 1; i <= n; i++) {
        s = sec[i]
        if (!(s in seen)) err("has no ## " s " section")
        else if (items[s] == 0 && !(s == "Read" && fm["size"] == "XS")) err("## " s " has no items")
      }
    }
    END {
      finish()
      # Remove cards whose dependencies are all removed; what stays is a cycle
      # or depends on one.
      do {
        changed = 0
        for (id in deps) {
          if (id in gone) continue
          free = 1; n = split(deps[id], d, " ")
          for (i = 1; i <= n; i++) if ((d[i] in deps) && !(d[i] in gone)) free = 0
          if (free) { gone[id] = 1; changed = 1 }
        }
      } while (changed)
      for (id in deps) if (!(id in gone)) { file = first[id]; err("is in, or depends on, a dependency cycle") }
      exit bad
    }' "$@"
}

lint_logs() {
  [ "$#" -gt 0 ] || return 0
  awk -v allowed=" card date outcome branch pr size budget_tokens baseline_tokens peak_tokens growth_tokens compacted " "$LINT_LIB"'
    function measured(k) {
      if ((k in fm) && fm[k] !~ /^[0-9]+$/ && fm[k] != "unknown") err(k " must be a number or unknown")
    }
    function finish(   i, n, d, name, sec) {
      if (!shape_ok()) return
      n = split(file, d, "/"); name = d[n]
      if (name !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[A-Z][A-Z0-9]*-[0-9]+[a-z]?-[0-9]+\.md$/) {
        err("is not named <date>-<id>-<n>.md"); return
      }
      require("card date outcome branch size budget_tokens baseline_tokens peak_tokens growth_tokens compacted")
      sub(/-[0-9]+\.md$/, "", name)
      if (("date" in fm) && fm["date"] != substr(name, 1, 10)) err("date " fm["date"] " does not match the file name")
      if (("card" in fm) && fm["card"] != substr(name, 12)) err("card " fm["card"] " does not match the file name")
      if (("outcome" in fm) && fm["outcome"] !~ /^(done|split|blocked|review-fixes)$/) err("outcome must be done, split, blocked or review-fixes")
      measured("budget_tokens"); measured("baseline_tokens"); measured("peak_tokens"); measured("growth_tokens")
      if (("compacted" in fm) && fm["compacted"] !~ /^(true|false|unknown)$/) err("compacted must be true, false or unknown")
      if (("pr" in fm) && fm["pr"] !~ /^[0-9]*$/) err("pr must be a number")
      if (body > 40) err("is longer than 40 lines after the front matter (" body ")")
      n = split("Done Tests Deviations Follow-ups", sec, " ")
      for (i = 1; i <= n; i++) if (!(sec[i] in seen)) err("has no ## " sec[i] " section")
    }
    END { finish(); exit bad }' "$@"
}

cmd_lint() {
  local f rc=0 index
  need_check
  index=$(wt_cards)
  for f in "$CARDS_DIR"/*.md; do
    [ -f "$f" ] || continue
    [ "$f" != "$CARDS_DIR/REVIEW.md" ] || continue
    printf '%s\n' "$index" | F="$f" awk -F '\t' '$2 == ENVIRON["F"] { found = 1 } END { exit !found }' && continue
    printf 'card: %s: file name does not start with a card id\n' "$f" >&2
    rc=1
  done

  # Card and log paths cannot contain spaces or glob characters by the time
  # they are in an index or match the log name, but quote through set -- anyway.
  set --
  while IFS="$TAB" read -r _ f; do
    [ -n "$f" ] && set -- "$@" "$f"
  done <<INDEX
$index
INDEX
  lint_cards "$@" >&2 || rc=1

  set --
  for f in "$LOG_DIR"/*.md; do
    [ -f "$f" ] && set -- "$@" "$f"
  done
  lint_logs "$@" >&2 || rc=1
  return "$rc"
}

# --- deck ---

# wt_meta <file...>: "<path> <size> <title> <depends> <done>", tab-separated,
# from the front matter of each file. Control characters are removed and the
# title is capped, because these fields are printed into an agent's context.
wt_meta() {
  [ "$#" -gt 0 ] || return 0
  awk '
    function flush() {
      if (file != "") print file "\t" fm["size"] "\t" substr(fm["title"], 1, 80) "\t" fm["depends"] "\t" fm["done"]
    }
    FNR == 1 { flush(); file = FILENAME; split("", fm); infm = 0 }
    { sub(/\r$/, "") }
    FNR == 1 { infm = ($0 == "---"); next }
    infm && $0 == "---" { infm = 0; next }
    infm {
      i = index($0, ":")
      if (i == 0) next
      k = substr($0, 1, i - 1); v = substr($0, i + 1)
      gsub(/[\001-\037\177]/, "", v); gsub(/^ +| +$/, "", v)
      if (!(k in fm)) fm[k] = v
    }
    END { flush() }' "$@"
}

# deck_table: one line per card in natural id order, tab-separated:
# "<state> <id> <size> <title> <why>". <why> lists unmet dependencies.
deck_table() {
  local index f
  index=$(wt_cards)
  set --
  while IFS="$TAB" read -r _ f; do
    [ -n "$f" ] && set -- "$@" "$f"
  done <<INDEX
$index
INDEX
  {
    printf '%s\n' "$index" | awk 'NF { print "C\t" $0 }'
    wt_meta "$@" | awk '{ print "M\t" $0 }'
  } | awk -F '\t' '
    $1 == "C" { if (!($2 in path)) { order[++n] = $2; path[$2] = $3 } }
    $1 == "M" { size[$2] = $3; title[$2] = $4; deps[$2] = $5; if ($6 == "true") done[$2] = 1 }
    END {
      for (i = 1; i <= n; i++) if (path[order[i]] in done) isdone[order[i]] = 1
      for (i = 1; i <= n; i++) {
        id = order[i]; p = path[id]; why = ""
        m = split(deps[p], d, ",")
        for (j = 1; j <= m; j++) {
          x = d[j]; gsub(/ /, "", x)
          if (x != "" && !(x in isdone)) why = why (why == "" ? "" : " ") x
        }
        if (id in isdone) state = "done"
        else if (why == "") state = "ready"
        else state = "waiting"
        print state "\t" id "\t" size[p] "\t" title[p] "\t" why
      }
    }'
}

cmd_list() {
  deck_table | awk -F '\t' '{ printf "%-8s %-12s %-3s %s\n", $1, $2, $3, $4 }'
}

# --- commands above this line ---

FETCH=0
n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  if [ "$a" = --fetch ]; then FETCH=1; else set -- "$@" "$a"; fi
done

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
cmd=$1
shift
case $cmd in
  help | -h | --help)
    usage
    exit 0
    ;;
  next | show | list | status | new | done | lint | touched | tests | tokens | log-new | stats | conf)
    enter_repo
    load_conf
    ;;
  *) die 2 "unknown command '$cmd'; run 'card help'" ;;
esac

case $cmd in
  conf) cmd_conf "$@" ;;
  show) cmd_show "$@" ;;
  lint) cmd_lint "$@" ;;
  list) cmd_list "$@" ;;
  *) die 2 "command '$cmd' is not implemented yet" ;;
esac
