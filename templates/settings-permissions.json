{
  "permissions": {
    "allow": [
      "Bash(card *)",
      "Bash(<check>)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git merge-base *)",
      "Bash(git push -u origin card/*)",
      "Bash(git push origin card/*)",
      "Bash(git branch --list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "Bash(date +%y%m%d%H%M)"
    ],
    "deny": [
      "Bash(git push *:*)",
      "Bash(git push origin card/* *)",
      "Bash(git push -u origin card/* *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * +*)",
      "Bash(git push * --delete *)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(gh pr merge *)"
    ]
  }
}
